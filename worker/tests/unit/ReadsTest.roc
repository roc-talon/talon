# ---- tests ----

# Rule ids: R-AP1 R-AP2 R-AP13 R-AP14 (routes, ids, query, bodies), R-AP24 (ETag), R-AP43 (cache decision), R-AP41 (session), R-AP29 (checked),
# R-AP32 (repos), R-AP49 (the record forms), R-AP48 (the order of the checks), R-AP21 (the problem), R-IK2 (the ids).

# ---- routes (R-AP48 rows 1 and 2) ----
route = |method, segments| Route.decide({ method, segments, content_type: Err(NotFound), has_body: Bool.False })

no_route = |method, path| Refuse(Problem.new(NotFound, "no route for ${method} ${path}"))

not_allowed = |method, path| NotAllowed(Problem.new(MethodNotAllowed, "${method} is not allowed on ${path}"), ["GET"])

# R-AP1, R-AP2, R-AP13, R-AP14, R-AP48: GET is served on the three paths, any other method is 405 with Allow GET, a near miss is 404.
# Slice 112 (R-AP9, R-AP26): POST /v1/releases is the ingest, so /v1/releases has Allow GET, POST.
expect {
	got = [
		route("GET", ["v1", "packages", "roc-lang", "unicode", "releases"]),
		route("GET", ["v1", "artifacts", "abc"]),
		route("GET", ["v1", "releases"]),
		route("POST", ["v1", "releases"]),
		route("DELETE", ["v1", "artifacts", "abc"]),
		route("PUT", ["v1", "packages", "o", "r", "releases"]),
		route("PATCH", ["v1", "releases"]),
		route("GET", ["v1", "packages", "o", "releases"]),
		route("GET", ["v1", "packages", "o", "r", "releases", "x"]),
		route("GET", ["v1", "artifacts"]),
		route("GET", ["v1", "artifacts", "a", "b"]),
		route("GET", ["v1", "releases", "1"]),
	]
	got == [
		Handle(GetRepoReleases("roc-lang", "unicode")),
		Handle(GetArtifact("abc")),
		Handle(GetReleases),
		Handle(PostRelease),
		not_allowed("DELETE", "/v1/artifacts/abc"),
		not_allowed("PUT", "/v1/packages/o/r/releases"),
		NotAllowed(Problem.new(MethodNotAllowed, "PATCH is not allowed on /v1/releases"), ["GET", "POST"]),
		no_route("GET", "/v1/packages/o/releases"),
		no_route("GET", "/v1/packages/o/r/releases/x"),
		no_route("GET", "/v1/artifacts"),
		no_route("GET", "/v1/artifacts/a/b"),
		no_route("GET", "/v1/releases/1"),
	]
}

# ---- ids (R-IK2, R-AP2): sha256(kind byte + bytes)[:8], big-endian signed ----
# A hash is 32 bytes of base58. The names h31 and h33 are the base58 of 31 and of 33 bytes.
# R-AP2, R-IK2: the id of a hash.
expect {
	(Reads.artifact_id(b1) == Ok(5265119941757224538)) and (Reads.artifact_id(b3) == Ok(-3201922985822262901)) and (Reads.artifact_id(b4) == Ok(-9216385313920979605))
}

# R-AP2: a text that is no hash of 32 bytes (the route answer is question Q106-5).
expect {
	h31 = "1CiMQsCUhqABwwLyCFeX2iPnBZX3s28dUUCBrirhs"
	h33 = "14wBqpZM9xaSheZzJSMawUKKwhdpChKbZ5eu5ky4Vigw"
	bad = ["", "0OIl", "abc def", h31, h33, b1.drop_suffix("E"), "${b1}0"].map(Reads.artifact_id)
	bad == List.repeat(Err(BadHash), 7)
}

# R-AP13, R-AP1, R-AP56: the group id (exact bytes) and the repo id (ASCII letters made lower case first). The first group id is the example of the design (case K8).
expect {
	(Reads.form_id(g1) == -2687166099708853831) and (Reads.form_id(g1b) == 1924886514749142907) and (Reads.form_id(gx) == -6218357134827835138)
		and (Reads.repo_id("roc-lang", "unicode") == -3025687567124958779) and (Reads.repo_id("roc-lang", "other") == 4172983114642615821)
		and (Reads.repo_id("Roc-Lang", "Unicode") == -3025687567124958779) and (Reads.repo_id("ROC-LANG", "Other") == 4172983114642615821)
}

# ---- the query of GET /v1/releases (R-AP13, R-AP14, R-AP48 row 6) ----
query = |group, series, after| Reads.parse_query({ group, series, after })

# R-AP13, R-AP14, R-AP56: the valid queries. `after` is at most 2^63 - 1. `series` with `after` and no `group` is ignored (Q106-3).
expect {
	ok = [
		query(Ok(g1), Err(NotFound), Err(NotFound)),
		query(Ok(g1), Ok("4"), Err(NotFound)),
		query(Ok(g1), Ok("0.25"), Ok("17")),
		query(Err(NotFound), Err(NotFound), Ok("0")),
		query(Ok(gx), Err(NotFound), Ok("1000")),
		query(Ok(g1), Err(NotFound), Ok("9223372036854775807")),
		query(Err(NotFound), Ok("4"), Ok("5")),
		query(Err(NotFound), Ok("x"), Ok("5")),
	]
	ok == [
		Ok(ByGroup({ group: g1, series: Err(None), after: Err(None) })),
		Ok(ByGroup({ group: g1, series: Ok("4"), after: Err(None) })),
		Ok(ByGroup({ group: g1, series: Ok("0.25"), after: Ok(17) })),
		Ok(ByAfter(0)),
		Ok(ByGroup({ group: gx, series: Err(None), after: Ok(1000) })),
		Ok(ByGroup({ group: g1, series: Err(None), after: Ok(9223372036854775807) })),
		Ok(ByAfter(5)),
		Ok(ByAfter(5)),
	]
}

bad_request = |detail| Err(Problem.new(BadRequest, detail))

# R-AP13, R-AP14, R-AP48 row 6, R-AP56, R-AP21: the 400 rows, in the order of the rules of `parse_query`. `series` alone is 400 (rule 1). `after`: no leading zero, at most 2^63 - 1.
expect {
	need = "GET /v1/releases needs the query parameter group or after"
	empty = "the query parameter group must not be empty"
	after = |t| "the query parameter after must be a log index (decimal digits), got ${t}"
	series = |t| "the query parameter series must be a series (M or 0.m), got ${t}"
	got = [
		query(Err(NotFound), Err(NotFound), Err(NotFound)),
		query(Ok(""), Err(NotFound), Err(NotFound)),
		query(Ok(""), Err(NotFound), Ok("5")),
		query(Ok(g1), Err(NotFound), Ok("")),
		query(Err(NotFound), Err(NotFound), Ok("-1")),
		query(Err(NotFound), Err(NotFound), Ok("+1")),
		query(Ok(g1), Err(NotFound), Ok("1.5")),
		query(Ok(g1), Err(NotFound), Ok("abc")),
		query(Ok(g1), Err(NotFound), Ok("1e3")),
		query(Ok(g1), Err(NotFound), Ok(" 5")),
		query(Ok(g1), Ok("0"), Err(NotFound)),
		query(Ok(g1), Ok("x"), Err(NotFound)),
		query(Ok(g1), Ok("1.2"), Err(NotFound)),
		query(Ok(g1), Ok(""), Err(NotFound)),
		query(Ok(g1), Ok("01"), Err(NotFound)),
		query(Ok(g1), Ok("y"), Ok("x")),
		query(Err(NotFound), Ok("4"), Err(NotFound)),
		query(Ok(g1), Err(NotFound), Ok("007")),
		query(Ok(g1), Err(NotFound), Ok("00")),
		query(Ok(g1), Err(NotFound), Ok("9223372036854775808")),
	]
	got == [
		bad_request(need),
		bad_request(empty),
		bad_request(empty),
		bad_request(after("")),
		bad_request(after("-1")),
		bad_request(after("+1")),
		bad_request(after("1.5")),
		bad_request(after("abc")),
		bad_request(after("1e3")),
		bad_request(after(" 5")),
		bad_request(series("0")),
		bad_request(series("x")),
		bad_request(series("1.2")),
		bad_request(series("")),
		bad_request(series("01")),
		bad_request(after("x")),
		bad_request(need),
		bad_request(after("007")),
		bad_request(after("00")),
		bad_request(after("9223372036854775808")),
	]
}

# ---- the ETag and the conditional request (R-AP24) ----
# sha256("abc") = ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad, sha256("") = e3b0c44298fc1c149afbf4c8996fb924...
# R-AP24, R-AP54: the form of the ETag.
expect {
	(Reads.etag_of("abc".to_utf8()) == "\"ba7816bf8f01cfea414140de5dae2223\"") and (Reads.etag_of([]) == "\"e3b0c44298fc1c149afbf4c8996fb924\"") and (Reads.etag_of(body_page0.to_utf8()) == etag_page0)
}

# R-AP24, R-AP54: If-None-Match against the ETag (weak comparison).
expect {
	e = "\"x\""
	yes = [
		"\"x\"",
		"  \"x\"  ",
		"\"a\", \"x\"",
		"\"x\", \"b\"",
		"\"a\",\"x\",\"b\"",
		"W/\"x\"",
		"\"a\", W/\"x\"",
		"*",
		" * ",
	]
	no = ["", "\"y\"", "x", "\"x", "x\"", "\"xx\"", "\"a\", \"b\"", "W/", "W/\"y\"", "\"X\"", "**"]
	(yes.map(|v| Reads.etag_matches(v, e)) == List.repeat(Bool.True, 9)) and (no.map(|v| Reads.etag_matches(v, e)) == List.repeat(Bool.False, 11))
}

# ---- the cache decision (R-AP43) and the session (R-AP41 row 5) ----
bypass = |cc, pragma| Reads.bypass_cache({ cache_control: cc, pragma })

# R-AP43, R-AP55: Cache-Control no-cache and Pragma no-cache skip the cache read. No other directive counts (`max-age=0`, `no-store`, `private`).
expect {
	nf = Err(NotFound)
	yes = [
		bypass(Ok("no-cache"), nf),
		bypass(Ok("No-Cache"), nf),
		bypass(Ok(" NO-CACHE "), nf),
		bypass(Ok("max-age=0, no-cache"), nf),
		bypass(Ok("no-cache, no-store"), nf),
		bypass(Ok("max-age=60,no-cache,private"), nf),
		bypass(nf, Ok("no-cache")),
		bypass(nf, Ok("No-Cache")),
		bypass(nf, Ok("foo, no-cache")),
		bypass(Ok("max-age=60"), Ok("no-cache")),
	]
	no = [
		bypass(nf, nf),
		bypass(Ok(""), Ok("")),
		bypass(Ok("no-cachex"), nf),
		bypass(Ok("xno-cache"), nf),
		bypass(Ok("max-age=60"), nf),
		bypass(Ok("private"), Ok("cache")),
		bypass(nf, Ok("no-cache-please")),
		bypass(Ok("max-age=0"), nf),
		bypass(Ok("no-store"), nf),
	]
	(yes == List.repeat(Bool.True, 10)) and (no == List.repeat(Bool.False, 9))
}

# R-AP41 row 5, R-AP55, Q46: the Talon-Bookmark header gives After(bookmark). White space at the ends is cut. An empty value is Any.
expect {
	[Reads.session_of(Err(NotFound)), Reads.session_of(Ok("")), Reads.session_of(Ok("   ")), Reads.session_of(Ok("abc")), Reads.session_of(Ok("  abc-1 "))]
		== [Any, Any, Any, After("abc"), After("abc-1")]
}

# ---- checked and repos (R-AP29, R-AP32) ----
# R-PU22: 1 h without the App, 24 h with it. Stale: never read, or more than 2 intervals old. Exactly 2 intervals is not stale.
# R-AP29, R-PU22: stale.
expect {
	now = 1767225600000
	hour = 3600000
	st = |at, with_app| Reads.stale({ checked_at: at, app_installed: with_app, now_ms: now })
	got = [
		st(Err(None), Bool.False),
		st(Err(None), Bool.True),
		st(Ok(now), Bool.False),
		st(Ok(now - 2 * hour), Bool.False),
		st(Ok(now - 2 * hour - 1), Bool.False),
		st(Ok(now - 2 * hour - 1), Bool.True),
		st(Ok(now - 48 * hour), Bool.True),
		st(Ok(now - 48 * hour - 1), Bool.True),
		st(Ok(now + hour), Bool.False),
	]
	(Reads.interval_ms(Bool.False) == hour) and (Reads.interval_ms(Bool.True) == 24 * hour)
		and (got == [Bool.True, Bool.True, Bool.False, Bool.False, Bool.True, Bool.False, Bool.False, Bool.True, Bool.False])
}

# R-AP29: the checked item from a repo_checks row.
expect {
	now = 1767225600000
	never = Reads.checked_of_row({ name: "roc-lang/other", checked_at: Err(Missing), app_installed: Bool.False }, now)
	old = Reads.checked_of_row({ name: "roc-lang/unicode", checked_at: Ok(now - 10800000), app_installed: Bool.False }, now)
	app_row = Reads.checked_of_row({ name: "roc-lang/unicode", checked_at: Ok(now - 10800000), app_installed: Bool.True }, now)
	(never == { name: "roc-lang/other", checked_at: Err(None), stale: Bool.True })
		and (old == { name: "roc-lang/unicode", checked_at: Ok(now - 10800000), stale: Bool.True })
		and (app_row == { name: "roc-lang/unicode", checked_at: Ok(now - 10800000), stale: Bool.False })
}

# R-AP32: the repos item from a repos row.
expect {
	row = |state, successor| Reads.repo_item_of_row({ name: "roc-lang/unicode", state, successor, state_at: 5 })
	bad = [row(3, Err(Missing)), row(-1, Err(Missing))].map(|r| r.is_err())
	(row(0, Err(Missing)) == Ok({ name: "roc-lang/unicode", state: Active, successor: Err(None), state_at: 5 }))
		and (row(1, Err(Missing)) == Ok({ name: "roc-lang/unicode", state: Missing, successor: Err(None), state_at: 5 }))
		and (row(2, Ok("roc-lang/moved")) == Ok({ name: "roc-lang/unicode", state: Moved, successor: Ok("roc-lang/moved"), state_at: 5 }))
		and (bad == [Bool.True, Bool.True])
}

# ---- the rows of releases and artifacts (R-AP49, R-IK1, R-IK5) ----
# rr1: an exact key, a GitHub release. rr2: a version below 1.0, another host, null columns, withdrawn. rr3: a saturated key with version_text.
expect {
	(Reads.release_of_row(rr1) == Ok(er1)) and (Reads.release_of_row(rr2) == Ok(er2)) and (Reads.release_of_row(rr3) == Ok(er3))
}

# R-AP49, R-IK1, R-RE2: the rows that are not valid.
# A hash of 31 or 33 bytes, a version column that is no number, a version_text that is no version, an empty version_text with a key that is not exact.
expect {
	bad = [
		{ ..rr1, hash: h1.take_first(31) },
		{ ..rr1, hash: h1.concat([0]) },
		{ ..rr1, hash: [] },
		{ ..rr1, version: "abc" },
		{ ..rr3, version_text: "not a version" },
		{ ..rr3, version_text: "" },
		{ ..rr1, vias: Ok("4") },
		{ ..rr1, vias: Ok("ingest") },
	].map(|r| Reads.release_of_row(r).is_err())
	bad == List.repeat(Bool.True, 8)
}

# Slice 122, R-AP49 `provenance`, R-PU15 (the strength order oidc, webhook, poll, ingest), R-RE9 (the codes 0 to 3): the codes of the rows of `provenance` become the texts, strongest first, whatever the order of the codes.
# The 24 orders of the 4 codes, the shorter lists, a pair that a publish after an ingest makes (R-PU16), one code.
expect {
	all4 = ["oidc", "webhook", "poll", "ingest"]
	codes = ["0", "1", "2", "3"]
	perms = codes.join_map(|a| codes.keep_if(|b| b != a).join_map(|b| codes.keep_if(|c| c != a and c != b).join_map(|c| codes.keep_if(|d| d != a and d != b and d != c).map(|d| Str.join_with([a, b, c, d], ",")))))
	perms.len() == 24 and perms.all(|t| Reads.provenance_of(Ok(t)) == Ok(all4)) and (Reads.provenance_of(Ok("3,0")) == Ok(["oidc", "ingest"])) and (Reads.provenance_of(Ok("0,3")) == Ok(["oidc", "ingest"])) and (Reads.provenance_of(Ok("2,1")) == Ok(["webhook", "poll"])) and (Reads.provenance_of(Ok("3,2")) == Ok(["poll", "ingest"])) and (Reads.provenance_of(Ok("3,1,2")) == Ok(["webhook", "poll", "ingest"])) and (Reads.provenance_of(Ok("0")) == Ok(["oidc"])) and (Reads.provenance_of(Ok("1")) == Ok(["webhook"])) and (Reads.provenance_of(Ok("2")) == Ok(["poll"])) and (Reads.provenance_of(Ok("3")) == Ok(["ingest"]))
}

# Slice 122, R-AP49: a code that is not 0 to 3, and a text that is not a list of codes, is a bad row (the handler gives 500 `internal`, R-AP48). The first good code does not save the list.
# A code is written once in `provenance` (the key is (release, via), R-RE9), so a list with one code two times is not tested.
expect {
	bad = ["4", "3,4", "4,0", "-1", "x", "oidc", "0;3", "1.0", "255", "256"].map(|t| Reads.provenance_of(Ok(t)).is_err())
	bad == List.repeat(Bool.True, 10)
}

# R-AP2, R-AP49, R-RE1, R-RE19, R-RE20: artifact records from rows.
expect {
	(Reads.artifact_of_rows(art1_rows) == Ok(art1)) and (Reads.artifact_of_rows(art2_rows) == Ok(art2)) and (Reads.artifact_of_rows(art3_rows) == Ok(art3))
}

# R-AP49, Q106-8: a dep with no version (form and version NULL): `group` is the URL with no scheme, no last segment and no `{v}`.
expect {
	url = "https://example.com/pkg/lib/${b2}.tar.zst"
	dep = { alias: "c", hash: h2, form: Err(Missing), version: Err(Missing), version_text: Err(Missing), url, is_platform: Bool.False }
	want = { ..art2, deps: [{ alias: "c", hash: b2, group: "example.com/pkg/lib/", series: Err(None), version: Err(None), url, is_platform: Bool.False }] }
	Reads.artifact_of_rows({ ..art2_rows, deps: [dep] }) == Ok(want)
}

# R-AP49: the artifact rows that are not valid.
# Kind 3 is no kind. `exposed_json` that is no JSON array of text, a dep hash of 31 bytes, a platform hash of 31 bytes.
expect {
	rows = art1_rows
	bad = [
		Reads.artifact_of_rows({ ..rows, artifact: { ..rows.artifact, kind: 3 } }),
		Reads.artifact_of_rows({ ..rows, artifact: { ..rows.artifact, exposed_json: "Unicode" } }),
		Reads.artifact_of_rows({ ..rows, artifact: { ..rows.artifact, exposed_json: "[1]" } }),
		Reads.artifact_of_rows({ ..art3_rows, artifact: { ..art3_rows.artifact, platform_hash: Ok(h4.take_first(31)) } }),
		Reads.artifact_of_rows({ ..rows, deps: rows.deps.map(|d| { ..d, hash: d.hash.take_first(31) }) }),
	].map(|r| r.is_err())
	bad == List.repeat(Bool.True, 5)
}

# ---- the bodies (R-AP1, R-AP13, R-AP14, R-AP2, R-AP24, R-AP32, R-AP53) ----
# The text is the bytes that the ETag covers: no white space, the members in the order of the slice file, the repos sorted by name.
expect {
	(Reads.releases_body({ releases: [er1, er2], checked: Ok(chk1), repos: [rp1, rp2] }) == body_rel)
		and (Reads.releases_body({ releases: [], checked: Err(None), repos: [] }) == body_null)
}

expect {
	(Reads.page_body({ releases: [er3], repos: [rp1] }) == body_page) and (Reads.page_body({ releases: [], repos: [] }) == body_page0)
}

expect {
	Reads.artifact_body({ artifact: art1, releases: [er1], repos: [rp1] }) == body_art
}

# R-AP21: the 404 problems of R-AP1 and R-AP2 (proposed texts).
expect {
	(Reads.no_repo_releases("roc-lang", "nope") == Problem.new(NotFound, "no indexed release for roc-lang/nope"))
		and (Reads.no_artifact("abc") == Problem.new(NotFound, "no artifact abc"))
}

# Slice 122, R-AP49 `provenance`, R-AP53, R-AP73: the three bodies write the member in each release, between `log_index` and `published_at`, as the list of the release is given (the sort is in `provenance_of`). Three releases with 2, 1 and 4 texts.
expect {
	rel = Reads.releases_body({ releases: [er1, er2, er3], checked: Err(None), repos: [] })
	page = Reads.page_body({ releases: [er1, er2, er3], repos: [] })
	art = Reads.artifact_body({ artifact: art1, releases: [er1, er2, er3], repos: [] })
	marks = ["\"log_index\":2,\"provenance\":[\"oidc\",\"ingest\"],\"published_at\"", "\"log_index\":5,\"provenance\":[\"webhook\"],\"published_at\"", "\"log_index\":9,\"provenance\":[\"oidc\",\"webhook\",\"poll\",\"ingest\"],\"published_at\""]
	[rel, page, art].all(|b| marks.all(|m| b.contains(m)))
}

# Slice 122, Q341 (Design), R-AP49: a release with no `provenance` row (`vias` is NULL) gives `provenance: []`. It is not a bad row, and the other releases of the page are unchanged.
expect {
	none = { ..rr2, vias: Err(Missing) }
	page = [rr1, none, rr3].map_try(Reads.release_of_row)
	(Reads.provenance_of(Err(Missing)) == Ok([])) and (Reads.release_of_row(none) == Ok({ ..er2, provenance: [] })) and page == Ok([er1, { ..er2, provenance: [] }, er3])
}
