import lib.LogStep

LogStepTest :: [].{}

# W0 tests of worker/lib/LogStep.roc (slice 257b, docs/slices/257-log-tiles.md section 3.4). The tlog math is records.Tlog (slice 257a, its own tests).
# The W2 cases of the step are worker/tests/cases/log/ (made by research/slice-257b-vectors/cases.mjs). The key vectors below come from the same script (node:crypto).

# --- vectors: generated by research/slice-257b-vectors/cases.mjs, do not edit ---

# The throwaway test key of research/slice-257a-vectors/vectors.mjs: the signer key text, the public key, the key id, and the JWK text of the private key
# as an export gives it (node:crypto; WebCrypto gives the same members). The second key: only its public key and its key id (for a wrong key id).
vec_key : { signer : Str, public : Str, key_id : Str, jwk : Str, other_public : Str, other_key_id : Str }
vec_key = { signer: "PRIVATE+KEY+registry.roc-talon.org/log+ef85463f+AbN3kDu1rU6Ae40mYF0tNdIAM2JAE1z1OV3ZGBWh44Zk", public: "33a2ee5ac65b3cc99933a47122e241b759f62ffbbf9d7fa51c95f52e831c83e2", key_id: "ef85463f", jwk: "{\"crv\":\"Ed25519\",\"d\":\"s3eQO7WtToB7jSZgXS010gAzYkATXPU5XdkYFaHjhmQ\",\"ext\":true,\"key_ops\":[\"sign\"],\"kty\":\"OKP\",\"x\":\"M6LuWsZbPMmZM6RxIuJBt1n2L_u_nX-lHJX1LoMcg-I\"}", other_public: "f4c8b7656a43d86b302f850f976c6928e3515cdf3589deaba4c2550ebb64f355", other_key_id: "713033e5" }

# --- end of vectors ---

origin : Str
origin = "registry.roc-talon.org/log"

# Bytes of a hex text (the vectors are lower-case hex).
hex : Str -> List(U8)
hex = |text| {
	digit = |c| {
		if c >= 'a' {
			c - 'a' + 10
		} else {
			c - '0'
		}
	}
	text.to_utf8().chunks_of(2).map(
		|pair| {
			match pair {
				[hi, lo] => digit(hi) * 16 + digit(lo)
				_ => 0
			}
		},
	)
}

grp : Str
grp = "github.com/acme/pkg/releases/download/{v}/"

hash : Str
hash = "6YbXkqTz7pUm2Ff8RcWvJ3s9Hd1LgAeNo4QxBiKt5uP"

# The D1 row of the leaf `idx` (R-SG2: tlog index idx - 1), and its entry bytes written by hand: `<grp> <version> <hash> <time>\n`.
row : I64 -> LogStep.Row
row = |idx| { idx, grp, version: "1.0.${(idx - 1).to_str()}", hash, time: 1763500000000 + (idx - 1) * 1000 }

text_of : I64 -> List(U8)
text_of = |idx| "${grp} 1.0.${(idx - 1).to_str()} ${hash} ${(1763500000000 + (idx - 1) * 1000).to_str()}\n".to_utf8()

rows : I64, I64 -> List(LogStep.Row)
rows = |from, to| (from..=to).iter().map(row).collect()

# R-SG7 (Design Q636): one step takes at most 65,536 leaves.
expect LogStep.cap == 65536

# R-PU35, R-WH14 (Cron triggers), Design Q636: the tile catch-up has its own cron expression, every 5 min at minute 2.
expect LogStep.cron == "2-59/5 * * * *"

# R-SG7 row 4, R-WH14 `LOG`: the checkpoint is the R2 key `checkpoint` (the path after `/log/`).
expect LogStep.checkpoint_key == "checkpoint"

# R-SG7 row 1: no leaf above S is no entry (the step then writes nothing).
expect LogStep.entries(0, []) == Ok([])

expect LogStep.entries(7, []) == Ok([])

# R-SG7 row 1, R-SG2: the leaves of an empty log are idx 1, 2, 3; the entry bytes are the columns as they are, in idx order.
expect LogStep.entries(0, rows(1, 3)) == Ok([text_of(1), text_of(2), text_of(3)])

# R-SG7 row 1: above the checkpoint size 3, the leaves start at idx 4.
expect LogStep.entries(3, rows(4, 5)) == Ok([text_of(4), text_of(5)])

# R-SG3, R-SG8: a compiler leaf: the same form, the text columns as D1 has them.
expect {
	leaf = { idx: 1, grp: "roc-lang/nightlies:x86_64-linux", version: "nightly-2026-10-14-38a3029", hash: "sha256:9e7c0e4b", time: 1760400000000 }
	LogStep.entries(0, [leaf]) == Ok(["roc-lang/nightlies:x86_64-linux nightly-2026-10-14-38a3029 sha256:9e7c0e4b 1760400000000\n".to_utf8()])
}

# R-SG7 row 1 (revert: a read of `idx >= S`): a row at idx S is the leaf of tlog index S - 1, which the checkpoint has already. It is a gap, not a leaf.
expect LogStep.entries(3, rows(3, 5)) == Err(Gap(3))

# R-SG5: D1 `idx` is max + 1, so a missing idx is a broken log: no tile is made from it.
expect LogStep.entries(3, [row(4), row(6)]) == Err(Gap(6))

expect LogStep.entries(3, rows(5, 6)) == Err(Gap(5))

expect LogStep.entries(0, [row(2), row(1)]) == Err(Gap(2))

# R-SG7 (Design Q636): exactly the cap is one step; one more row is too many (revert: the cap off by one).
expect {
	match LogStep.entries(0, rows(1, 65536)) {
		Ok(list) => list.len() == 65536
		Err(_) => Bool.False
	}
}

expect LogStep.entries(0, rows(1, 65537)) == Err(TooMany)

# R-SG7 (Design Q636): the cron goes on until the checkpoint size is the largest idx. A step that took the cap can leave more: one more step.
expect LogStep.again(Wrote({ from: 0, size: 65536, tiles: 513 }))

expect LogStep.again(Wrote({ from: 70000, size: 135536, tiles: 260 }))

# A step that took fewer leaves than the cap took them all (revert: the cap off by one).
expect !LogStep.again(Wrote({ from: 0, size: 65535, tiles: 512 }))

expect !LogStep.again(Wrote({ from: 3, size: 7, tiles: 2 }))

expect !LogStep.again(Same(0))

expect !LogStep.again(Same(65536))

# R-SG7 row 4: after a lost compare and swap, the step stops; the cron run does not go on (the other run did the work).
expect !LogStep.again(Lost({ size: 65536, theirs: 65536 }))

# R-SG7 row 4: the checkpoint that another run wrote has at least the size that the step wanted: stop. A smaller size is no stop (Q257-18: one more step; W2 sg7-race-smaller-*).
expect LogStep.stop_after_race(7, 7)

expect LogStep.stop_after_race(9, 7)

expect LogStep.stop_after_race(65536, 600)

expect !LogStep.stop_after_race(5, 7)

expect !LogStep.stop_after_race(0, 1)

# R-WH14 `LOG_KEY`: the public key is the member `x` (base64url) of the exported JWK.
expect LogStep.public_key(vec_key.jwk) == Ok(hex(vec_key.public))

expect LogStep.public_key("{\"x\":\"M6LuWsZbPMmZM6RxIuJBt1n2L_u_nX-lHJX1LoMcg-I\"}") == Ok(hex(vec_key.public))

expect LogStep.public_key("not json") == Err(BadJwk)

expect LogStep.public_key("{\"kty\":\"OKP\",\"crv\":\"Ed25519\"}") == Err(BadJwk)

# An `x` of 31 bytes and of 33 bytes is not an Ed25519 public key.
expect LogStep.public_key("{\"x\":\"M6LuWsZbPMmZM6RxIuJBt1n2L_u_nX-lHJX1LoMcgw\"}") == Err(BadJwk)

expect LogStep.public_key("{\"x\":\"M6LuWsZbPMmZM6RxIuJBt1n2L_u_nX-lHJX1LoMcg-IA\"}") == Err(BadJwk)

# R-WH14 (257a P2: the Worker checks it): the key id of the text is the key id of the key and of the name.
expect LogStep.check_key({ name: origin, key_id: hex(vec_key.key_id), seed: [] }, hex(vec_key.public)) == Ok({})

# R-WH14: another public key (the text of one key with the seed of another) is a wrong key id: 500 internal and no write.
expect LogStep.check_key({ name: origin, key_id: hex(vec_key.key_id), seed: [] }, hex(vec_key.other_public)) == Err(WrongKeyId)

expect LogStep.check_key({ name: origin, key_id: hex(vec_key.other_key_id), seed: [] }, hex(vec_key.public)) == Err(WrongKeyId)

# The key id covers the name: the same key under another name has another key id.
expect LogStep.check_key({ name: "other.example/log", key_id: hex(vec_key.key_id), seed: [] }, hex(vec_key.public)) == Err(WrongKeyId)

# R-AP23 (proposal P-b1): the content type stored with each object.
expect LogStep.content_type("checkpoint") == "text/plain; charset=utf-8"

expect LogStep.content_type("tile/0/000.p/3") == "application/octet-stream"

expect LogStep.content_type("tile/entries/x001/234") == "application/octet-stream"

expect LogStep.content_type("tile/1/000") == "application/octet-stream"
