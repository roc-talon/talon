import lib.LogKey

LogkeyTest :: [].{}

# Slice 261b (docs/slices/261-log-inclusion-proofs.md section 13). Pure: the log verifier key text (DESIGN-CLI 7.6 R-LV5, R-LV4; Registry R-SG4).
# The expected values come from research/slice-261-vectors/vectors.mjs (node:crypto, fixed test seeds), the built-in key (secrets/log-key-verifier, public),
# the 257a test key and the published example of golang.org/x/mod/sumdb/note.

nibble : U8 -> U8
nibble = |c| if (c >= 97) c - 87 else c - 48

from_hex : Str -> List(U8)
from_hex = |text| text.to_utf8().chunks_of(2).map(
	|p| match p {
		[a, b] => nibble(a) * 16 + nibble(b)
		_ => 0
	},
)

# The built-in key of tln (R-LV5) and its public key (research/slice-261-vectors/live.mjs).
builtin : Str
builtin = "registry.roc-talon.org/log+e5942107+AcChrF9eGpi29YDCTnBoS8Jd3xEVR1To+6RRg3korCQy"

builtin_public : Str
builtin_public = "c0a1ac5f5e1a98b6f580c24e70684bc25ddf11154754e8fba451837928ac2432"

# R-LV5: the built-in key: its name, its key id e5942107, its public key. The key data holds a `+`.
expect LogKey.parse_verifier_key(builtin) == Ok({ name: "registry.roc-talon.org/log", key_id: from_hex("e5942107"), public_key: from_hex(builtin_public) })

# R-LV5: the Go example key (PeterNeumann), the 257a test key, the test keys A and B (B has another name).
expect {
	go = "PeterNeumann+c74f20a3+ARpc2QcUPDhMQegwxbzhKqiBfsVkmqq/LDE4izWy10TW"
	t257 = "registry.roc-talon.org/log+ef85463f+ATOi7lrGWzzJmTOkcSLiQbdZ9i/7v51/pRyV9S6DHIPi"
	got = [go, t257, vec_keys.a.verifier, vec_keys.b.verifier].map(LogKey.parse_verifier_key)
	got
		== [
			Ok({ name: "PeterNeumann", key_id: from_hex("c74f20a3"), public_key: from_hex("1a5cd907143c384c41e830c5bce12aa8817ec5649aaabf2c31388b35b2d744d6") }),
			Ok({ name: "registry.roc-talon.org/log", key_id: from_hex("ef85463f"), public_key: from_hex("33a2ee5ac65b3cc99933a47122e241b759f62ffbbf9d7fa51c95f52e831c83e2") }),
			Ok({ name: "registry.roc-talon.org/log", key_id: from_hex(vec_keys.a.key_id), public_key: from_hex(vec_keys.a.public) }),
			Ok({ name: "witness.example.org/w1", key_id: from_hex(vec_keys.b.key_id), public_key: from_hex(vec_keys.b.public) }),
		]
}

# R-LV5: the key id in upper-case hex is the same key (Go reads it with ParseUint base 16).
expect LogKey.parse_verifier_key("registry.roc-talon.org/log+E5942107+AcChrF9eGpi29YDCTnBoS8Jd3xEVR1To+6RRg3korCQy") == LogKey.parse_verifier_key(builtin)

# R-LV5, R-LV4: not a verifier key: the key id of another key; type byte 2; 31 or 33 key bytes; no type byte; a name with a space (each of these with its matching key id).
expect {
	bad = [vec_bad_keys.wrong_id, vec_bad_keys.alg2, vec_bad_keys.short31, vec_bad_keys.long33, vec_bad_keys.no_type, vec_bad_keys.space_name]
	bad.map(LogKey.parse_verifier_key) == List.repeat(Err(BadKey), bad.len())
}

# R-LV5 (proposal of slice 261 section 12.4): a public key that is not a point of the curve (y = 2), with its matching key id, is not a verifier key.
expect LogKey.parse_verifier_key(vec_bad_keys.non_point) == Err(BadKey)

# R-LV5: bad texts: empty; 2 parts; an empty name; a key id of 7 or 9 digits, or not hex; key data that is not base64; a space before the name; a newline at the end;
# the signer form (PRIVATE+KEY+...).
expect {
	data = "AcChrF9eGpi29YDCTnBoS8Jd3xEVR1To+6RRg3korCQy"
	o = "registry.roc-talon.org/log"
	bad = [
		"",
		"${o}+e5942107",
		"+e5942107+${data}",
		"${o}+e594210+${data}",
		"${o}+e59421070+${data}",
		"${o}+z5942107+${data}",
		"${o}+e5942107+AcChrF9e!!",
		" ${builtin}",
		"${builtin}\n",
		"PRIVATE+KEY+${o}+ef85463f+AbN3kDu1rU6Ae40mYF0tNdIAM2JAE1z1OV3ZGBWh44Zk",
	]
	bad.map(LogKey.parse_verifier_key) == List.repeat(Err(BadKey), bad.len())
}

# --- vectors: generated by research/slice-261-vectors/vectors.mjs cli, do not edit ---

# Test keys (fixed test seeds): the verifier text, the 32-byte public key and the key id in hex. A and A2 have the name of the built-in key; B and C do not.
vec_keys : { a : { verifier : Str, public : Str, key_id : Str }, a2 : { verifier : Str, public : Str, key_id : Str }, b : { verifier : Str, public : Str, key_id : Str }, c : { verifier : Str, public : Str, key_id : Str } }
vec_keys = { a: { verifier: "registry.roc-talon.org/log+1a078f80+AR/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W5C", public: "1fc888bb84c705f58a78cea35a25668a599e03ea0170b1f939c81bbf51f96e42", key_id: "1a078f80" }, a2: { verifier: "registry.roc-talon.org/log+d08e1294+ARj1Rlo7svX3ka2gaSxV4e1cYIkNstRxH0j+Hpyw6WDU", public: "18f5465a3bb2f5f791ada0692c55e1ed5c60890db2d4711f48fe1e9cb0e960d4", key_id: "d08e1294" }, b: { verifier: "witness.example.org/w1+be8be942+AYgAz2SJHtNNY1oqn4Jt2n9P/Edn0L3y3+sbEbzlDNnj", public: "8800cf64891ed34d635a2a9f826dda7f4ffc4767d0bdf2dfeb1b11bce50cd9e3", key_id: "be8be942" }, c: { verifier: "example.org/log+e9506e69+AWD5DYMxg+npNDlJ+4JyVmWhE9cqFkLSpBt2hQ1nqj8B", public: "60f90d833183e9e9343949fb82725665a113d72a1642d2a41b76850d67aa3f01", key_id: "e9506e69" } }

# Key texts that are not verifier keys: type byte 2, 31 and 33 key bytes, no type byte, a key that is not a point (y = 2), a name with a space (each with its matching key id);
# the key of A with the key id of B.
vec_bad_keys : { alg2 : Str, short31 : Str, long33 : Str, no_type : Str, non_point : Str, space_name : Str, wrong_id : Str }
vec_bad_keys = { alg2: "registry.roc-talon.org/log+338a0f4b+Ah/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W5C", short31: "registry.roc-talon.org/log+a3365cbe+AR/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W4=", long33: "registry.roc-talon.org/log+1845f38b+AR/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W5CAA==", no_type: "registry.roc-talon.org/log+9f87bdd6+H8iIu4THBfWKeM6jWiVmilmeA+oBcLH5Ocgbv1H5bkI=", non_point: "registry.roc-talon.org/log+46418d7b+AQIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", space_name: "a b/log+489ae87d+AR/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W5C", wrong_id: "registry.roc-talon.org/log+be8be942+AR/IiLuExwX1injOo1olZopZngPqAXCx+TnIG79R+W5C" }

# --- end of vectors ---
