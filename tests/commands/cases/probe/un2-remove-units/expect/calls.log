args
env_all
clock
cwd
canonical $PROJECT/p1/main.roc
list_dirs $PROJECT/p1
list_dirs $PROJECT
read_files $PROJECT/p1/talon.toml
read_files $PROJECT/p1/main.roc
canonical $PROJECT/p1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
spawn_all limit=1
  job - /fake/bin/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/p1/main.roc $PROJECT/p1/talon.toml $HOME/.config/talon/config.toml
random
list_dirs $HOME/.cache/roc/packages
read_files $HOME/.cache/roc/packages/895yiekWBru1NBsyGpzBzHzqjLdBGbe5MkhtZ4325wWw/main.roc $HOME/.cache/roc/packages/7vqcxRy8v7AeYcCSstUq6Pjx8PuvoVvxdmhXvUYjTa21/main.roc
list_dirs $HOME/.cache/roc/toolchains
canonical $HOME/.cache $HOME/.cache/roc
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=2
random
copy_tree $PROJECT/p1 $HOME/.cache/roc/talon/tmp/0123456789abcdef
list_dirs $HOME/.cache/roc/talon/tmp/0123456789abcdef
write_atomic $HOME/.cache/roc/talon/tmp/0123456789abcdef/main.roc
probes 3
  probe $PROJECT/p1 nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
  probe $HOME/.cache/roc/packages/895yiekWBru1NBsyGpzBzHzqjLdBGbe5MkhtZ4325wWw nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
  probe $HOME/.cache/roc/packages/7vqcxRy8v7AeYcCSstUq6Pjx8PuvoVvxdmhXvUYjTa21 nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=2 existing=replace
probes 1
  probe $HOME/.cache/roc/talon/tmp/0123456789abcdef nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
platform
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=1
probes 1
  probe $HOME/.cache/roc/talon/tmp/0123456789abcdef nightly-2026-10-14-38a3029 /fake/bin/roc build main.roc --output=$HOME/.cache/roc/talon/tmp/0123456789abcdef/tln-probe.out timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=1 existing=replace
delete $HOME/.cache/roc/talon/tmp/0123456789abcdef
read_files $PROJECT/p1/main.roc
write_atomic $PROJECT/p1/main.roc
