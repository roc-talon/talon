args
env_all
clock
cwd
canonical $PROJECT/r1/main.roc
list_dirs $PROJECT/r1
list_dirs $PROJECT
read_files $PROJECT/r1/talon.toml
read_files $PROJECT/r1/main.roc
canonical $PROJECT/r1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
programs roc
spawn_all limit=1
  job - roc version
read_files $PROJECT/r1/main.roc $PROJECT/r1/talon.toml
read_files $PROJECT/r1/Helpers.roc $PROJECT/r1/Gone.roc
read_files $PROJECT/r1/Inner/Deep.roc $PROJECT/r1/Inner/Mid.roc
read_files $PROJECT/r1/Inner/Leaf.roc
random
copy_tree $PROJECT/r1 $HOME/.cache/roc/talon/tmp/0123456789abcdef
list_dirs $HOME/.cache/roc/talon/tmp/0123456789abcdef
list_dirs $HOME/.cache/roc/talon/tmp/0123456789abcdef/Inner
read_files $HOME/.cache/roc/talon/tmp/0123456789abcdef/Helpers.roc $HOME/.cache/roc/talon/tmp/0123456789abcdef/Inner/Deep.roc $HOME/.cache/roc/talon/tmp/0123456789abcdef/Inner/Leaf.roc $HOME/.cache/roc/talon/tmp/0123456789abcdef/Inner/Mid.roc
write_atomic $HOME/.cache/roc/talon/tmp/0123456789abcdef/main.roc
probes 2
  probe $PROJECT/r1 nightly-2026-10-14-38a3029 check main.roc timeout=30
  probe $HOME/.cache/roc/talon/tmp/0123456789abcdef nightly-2026-10-14-38a3029 check main.roc timeout=30
probes 1
  probe $HOME/.cache/roc/talon/tmp/0123456789abcdef nightly-2026-10-14-38a3029 build main.roc --output=$HOME/.cache/roc/talon/tmp/0123456789abcdef/tln-probe.out timeout=30
delete $HOME/.cache/roc/talon/tmp/0123456789abcdef
read_files $PROJECT/r1/talon.toml $PROJECT/r1/main.roc
write_atomic $PROJECT/r1/talon.toml $PROJECT/r1/main.roc
