read_files $PROJECT/r2/main.roc $PROJECT/r2/talon.toml $HOME/.config/talon/config.toml
random
list_dirs $HOME/.cache/roc/packages
programs curl wget
make_dirs $HOME/.cache/roc/packages/4gAvkRHDdEndqaanHcjMKebZJxta5pqHAohzhnFJiNUq.0123456789abcdef.tmp
