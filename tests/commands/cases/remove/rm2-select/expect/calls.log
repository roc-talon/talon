args
env_all
clock
cwd
canonical $PROJECT/r2/main.roc
list_dirs $PROJECT/r2
list_dirs $PROJECT
read_files $PROJECT/r2/talon.toml
read_files $PROJECT/r2/main.roc
canonical $PROJECT/r2/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
