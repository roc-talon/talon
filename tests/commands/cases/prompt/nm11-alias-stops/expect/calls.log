args
env_all
clock
cwd
canonical $PROJECT/app/main.roc
list_dirs $PROJECT/app
read_files $PROJECT/app/main.roc
canonical $PROJECT/app/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
programs roc
spawn_all limit=1
  job - roc version
read_files $PROJECT/app/main.roc $PROJECT/app/talon.toml $HOME/.config/talon/config.toml
list_dirs $HOME/.cache/roc/talon/index/github/acme/9lives
programs gh
http_get https://api.github.com/repos/acme/9lives/releases?per_page=100
  User-Agent: tln/0.0.0
write_atomic $HOME/.cache/roc/talon/index/github/acme/9lives/1.json $HOME/.cache/roc/talon/index/github/acme/9lives/1.meta
random
list_dirs $HOME/.cache/roc/packages
read_files $HOME/.cache/roc/packages/B8BEmGfcd49XAMfMC8a9ttLPzXq5xf87GUtkiqwTawt4/main.roc
