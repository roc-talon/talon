tty
env_all
clock
cwd
canonical $PROJECT/u1/main.roc
list_dirs $PROJECT/u1
list_dirs $PROJECT
read_files $PROJECT/u1/talon.toml
read_files $PROJECT/u1/main.roc
canonical $PROJECT/u1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $PROJECT/u1/main.roc $PROJECT/u1/talon.toml $HOME/.config/talon/config.toml
list_dirs $HOME/.cache/roc/toolchains
platform
read_files $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/toolchains.json
http_get http://127.0.0.1:9/v1/toolchains?after=0
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/toolchains.json
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 pinned=3
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 pinned=3
read_files $HOME/.cache/roc/talon/index/github/acme/json/repo.json $HOME/.cache/roc/talon/index/github/acme/parser/repo.json $HOME/.cache/roc/talon/index/github/acme/pfx/repo.json
http_send POST http://127.0.0.1:9/v1/closure timeout=20
  User-Agent: tln/0.0.1
  Content-Type: application/json
