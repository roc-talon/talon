args
env_all
tty
env_all
clock
cwd
canonical $PROJECT/p1/main.roc
list_dirs $PROJECT/p1
list_dirs $PROJECT
read_files $PROJECT/p1/main.roc
canonical $PROJECT/p1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
spawn_all limit=1
  job - /fake/bin/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/p1/main.roc $PROJECT/p1/talon.toml $HOME/.config/talon/config.toml
read_files $HOME/.cache/roc/talon/index/github/acme/limit/repo.json
http_get https://api.github.com/repos/acme/limit
  User-Agent: tln/0.0.1
  Authorization: Bearer tok1
write_atomic $HOME/.cache/roc/talon/index/github/acme/limit/repo.json
list_dirs $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/get
http_get http://127.0.0.1:9/v1/packages/acme/limit/releases
  User-Agent: tln/0.0.1
list_dirs $HOME/.cache/roc/talon/index/github/acme/limit
http_get https://api.github.com/repos/acme/limit/releases?per_page=100
  User-Agent: tln/0.0.1
  Authorization: Bearer tok1
write_atomic $HOME/.cache/roc/talon/index/github/acme/limit/1.json $HOME/.cache/roc/talon/index/github/acme/limit/1.meta
