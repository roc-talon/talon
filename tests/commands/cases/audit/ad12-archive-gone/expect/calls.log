delete $HOME/.cache/roc/packages/532HKEYYDQqzMZhSYLoLRNM98SZvHgQMP3BfwzuyRoMV.0123456789abcdef.tmp
random
list_dirs $HOME/.cache/roc/packages
read_files $HOME/.cache/roc/packages/2r9Lu7UYgi1kKtSUgf4fcvSU2hYjr3h7hGBaYNbpZJFL/main.roc
list_dirs $HOME/.cache/roc/talon/index/github/acme/pfx
programs gh
