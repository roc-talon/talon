tty
env_all
clock
cwd
canonical $PROJECT/q3/main.roc
list_dirs $PROJECT/q3
list_dirs $PROJECT
read_files $PROJECT/q3/main.roc
canonical $PROJECT/q3/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
read_files $PROJECT/q3/main.roc $PROJECT/q3/talon.toml $HOME/.config/talon/config.toml
random
list_dirs $HOME/.cache/roc/packages
programs curl wget
make_dirs $HOME/.cache/roc/packages/532HKEYYDQqzMZhSYLoLRNM98SZvHgQMP3BfwzuyRoMV.0123456789abcdef.tmp
spawn_all limit=8
