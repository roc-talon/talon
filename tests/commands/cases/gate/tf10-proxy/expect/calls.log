args
env_all
clock
cwd
canonical $PROJECT/in/main.roc
list_dirs $PROJECT/in
list_dirs $PROJECT
read_files $PROJECT/in/talon.toml
read_files $PROJECT/in/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
read_files $PROJECT/in/main.roc $PROJECT/in/talon.toml
list_dirs $HOME/.cache/roc/toolchains
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-14-38a3029/.last-use
canonical $HOME/.cache $HOME/.cache/roc
exec $HOME/.cache/roc/toolchains/nightly-2026-10-14-38a3029/roc check in/main.roc
  env XDG_CACHE_HOME=$HOME/.cache
  env ROC_CACHE_DIR=$HOME/.cache/roc
  env TALON_IN_PROXY=1
