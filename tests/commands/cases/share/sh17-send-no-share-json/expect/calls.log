env_all
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 queue_rows
read_files $HOME/.local/share/talon/share.json
lock $HOME/.local/share/talon/share.json nowait: held
read_files $HOME/.local/share/talon/share.json
random
random
random
write_atomic $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
spawn_all limit=1
  job - chmod 0600 $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
rename $HOME/.local/share/talon/share.json.0123456789abcdef.tmp $HOME/.local/share/talon/share.json
unlock $HOME/.local/share/talon/share.json
clock
http_send POST http://127.0.0.1:9/v1/compat timeout=5
  User-Agent: tln/0.9.0
  Content-Type: application/json
  Talon-Contributor: 0123456789abcdef0123456789abcdef
  <body> {"rows":[{"hash":"HA","nightly":"nightly-2026-10-14-38a3029","result":"pass","target":"any"},{"hash":"HB","nightly":"nightly-2026-10-14-38a3029","result":"fail","target":"any"}],"talon_version":"0.9.0"}
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 unqueue=2
clock
lock $HOME/.local/share/talon/share.json nowait: held
read_files $HOME/.local/share/talon/share.json
random
write_atomic $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
spawn_all limit=1
  job - chmod 0600 $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
rename $HOME/.local/share/talon/share.json.0123456789abcdef.tmp $HOME/.local/share/talon/share.json
unlock $HOME/.local/share/talon/share.json
