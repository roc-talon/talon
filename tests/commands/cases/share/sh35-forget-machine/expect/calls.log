args
env_all
read_files $HOME/.config/talon/config.toml
read_files $HOME/.local/share/talon/share.json
http_send DELETE http://127.0.0.1:9/v1/contributors/me timeout=20
  User-Agent: tln/0.0.1
  Talon-Contributor: 0123456789abcdeffedcba9876543210
random
random
lock $HOME/.local/share/talon/share.json nowait: held
read_files $HOME/.local/share/talon/share.json
random
write_atomic $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
spawn_all limit=1
  job - chmod 0600 $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
rename $HOME/.local/share/talon/share.json.0123456789abcdef.tmp $HOME/.local/share/talon/share.json
unlock $HOME/.local/share/talon/share.json
