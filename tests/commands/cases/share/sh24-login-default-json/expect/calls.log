args
env_all
read_files $HOME/.config/talon/config.toml
read_files $HOME/.local/share/talon/share.json
http_send POST https://github.com/login/device/code timeout=20
  Accept: application/json
  User-Agent: tln/0.0.1
  Content-Type: application/x-www-form-urlencoded
  <body> client_id=Ov23li2sxWgMaAvjaUbQ
clock
sleep 0
clock
http_send POST https://github.com/login/oauth/access_token timeout=20
  Accept: application/json
  User-Agent: tln/0.0.1
  Content-Type: application/x-www-form-urlencoded
  <body> client_id=Ov23li2sxWgMaAvjaUbQ&device_code=DC1&grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Adevice_code
http_send POST https://registry.example.org/v1/tokens timeout=20
  User-Agent: tln/0.0.1
  Content-Type: application/json
  Talon-Contributor: 0123456789abcdeffedcba9876543210
  <body> {"github_token":"gho_test"}
lock $HOME/.local/share/talon/share.json nowait: held
read_files $HOME/.local/share/talon/share.json
random
write_atomic $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
spawn_all limit=1
  job - chmod 0600 $HOME/.local/share/talon/share.json.0123456789abcdef.tmp
rename $HOME/.local/share/talon/share.json.0123456789abcdef.tmp $HOME/.local/share/talon/share.json
unlock $HOME/.local/share/talon/share.json
