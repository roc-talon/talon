args
env_all
clock
cwd
canonical $PROJECT/p1/main.roc
list_dirs $PROJECT/p1
list_dirs $PROJECT
read_files $PROJECT/p1/talon.toml
read_files $PROJECT/p1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
read_files $PROJECT/p1/main.roc $PROJECT/p1/talon.toml $HOME/.config/talon/config.toml
