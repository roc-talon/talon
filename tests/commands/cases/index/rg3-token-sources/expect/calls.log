env_all
list_dirs $HOME/.cache/roc/talon/index/github/acme/gh
programs gh
spawn_all limit=1
  job - gh auth token
http_get https://api.github.com/repos/acme/gh/releases?per_page=100
  User-Agent: tln/0.0.1
  Authorization: Bearer ghp_fromgh
write_atomic $HOME/.cache/roc/talon/index/github/acme/gh/1.json $HOME/.cache/roc/talon/index/github/acme/gh/1.meta
list_dirs $HOME/.cache/roc/talon/index/github/acme/gh2
http_get https://api.github.com/repos/acme/gh2/releases?per_page=100
  User-Agent: tln/0.0.1
  Authorization: Bearer viaenv
write_atomic $HOME/.cache/roc/talon/index/github/acme/gh2/1.json $HOME/.cache/roc/talon/index/github/acme/gh2/1.meta
list_dirs $HOME/.cache/roc/talon/index/github/acme/test
http_get http://127.0.0.1:1/api/repos/acme/test/releases?per_page=100
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/github/acme/test/1.json $HOME/.cache/roc/talon/index/github/acme/test/1.meta
