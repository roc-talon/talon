args
env_all
tty
env_all
clock
cwd
canonical $PROJECT/p1/main.roc
list_dirs $PROJECT/p1
list_dirs $PROJECT
read_files $PROJECT/p1/main.roc
canonical $PROJECT/p1/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
spawn_all limit=1
  job - /fake/bin/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/p1/main.roc $PROJECT/p1/talon.toml $HOME/.config/talon/config.toml
read_files $HOME/.cache/roc/talon/index/github/acme/known/repo.json
http_get https://api.github.com/repos/acme/known
  User-Agent: tln/0.0.1
  Authorization: Bearer tok1
write_atomic $HOME/.cache/roc/talon/index/github/acme/known/repo.json
list_dirs $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/get
http_get http://127.0.0.1:9/v1/packages/acme/known/releases
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/get/ae7fcf36e6e344437c63dea9b236a7cd.json $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/get/ae7fcf36e6e344437c63dea9b236a7cd.meta
read_files $HOME/.cache/roc/talon/index/github/acme/known/repo.json $HOME/.cache/roc/talon/index/github/acme/pfx/repo.json
http_send POST http://127.0.0.1:9/v1/closure timeout=20
  User-Agent: tln/0.0.1
  Content-Type: application/json
  <body> {"compilers":{"from":"nightly-2026-10-14-38a3029","to":"nightly-2026-10-14-38a3029"},"groups":[{"group":"github.com/acme/known/releases/download/{v}/"}],"hashes":["6ELEWECd4np7xs4pF1M2Acyy9ZXcKsJN36LKrNFDuoBL"]}
read_files $HOME/.local/share/talon/log/http_127.0.0.1_9/checkpoint
http_get http://127.0.0.1:9/log/checkpoint
  User-Agent: tln/0.0.1
read_files $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/log/tile/entries/000.p/3 $HOME/.cache/roc/talon/index/registry/http_127.0.0.1_9/log/tile/0/000.p/3
http_get_bytes http://127.0.0.1:9/log/tile/entries/000.p/3
  User-Agent: tln/0.0.1
http_get_bytes http://127.0.0.1:9/log/tile/0/000.p/3
  User-Agent: tln/0.0.1
