# R-NI10 R-NR2 R-S5 R-RM3 R-RM5 R-RM6 R-RM7 R-RM9 R-RM10 R-NM3 (slice 090): `tln tool remove talon` with a person there (a pseudo terminal, given/answers is `x`, then an empty line). The home is the home of `tools/rm1-remove-talon`.
# stdout and stderr are one stream, so the screen of the prompt (CLI 6.5) shows in expect/stdout (the typed answer does not). The answer `x` is no option, so the prompt is asked again. The empty answer is the default, option 1.
# The state after the run is the state of run 2 of `tools/rm1-remove-talon` (the same option): the same tree diff.
export TALON_NOW=2026-10-15T12:00:00Z
st() { echo "== $*"; if "$@"; then echo "exit 0"; else echo "exit $?"; fi; }
B=$HOME/.local/bin
DB=$XDG_DATA_HOME/talon/bin
ln -f $DB/tln $B/tln
ln -f $DB/tln $B/roc
ln -f $DB/foo $B/foo
ln -f $DB/bar $B/bar
st tln tool remove talon
ls -A $B
cat $B/roc
