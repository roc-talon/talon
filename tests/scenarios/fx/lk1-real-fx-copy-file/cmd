# R-LK2 R-R13 TW4 (slice 024b): copy_file! of the real Fx, with `fxprobe` (no Talon logic in it). One file is copied with its bytes and its permission bits (a compiler must stay executable). A link at the source is followed.
# Nothing is replaced, and nothing is made when the copy cannot start. Talon copies into a temp dir and renames the dir (R-CC1), so the call itself makes no temp file.
FX=$(command -v fxprobe)
mkdir -p src
printf '#!/bin/sh\necho "the copy runs: $0"\n' > src/roc
chmod 755 src/roc
printf 'plain data\n' > src/plain
chmod 644 src/plain

echo "== the bytes and the executable bit are copied. The parent dirs of the target are made."
$FX copyfile "$PWD/src/roc" "$PWD/out/deep/roc"
cmp src/roc out/deep/roc && echo "same bytes"
test -x out/deep/roc && echo "executable"
./out/deep/roc
echo "== a file that is not executable stays not executable"
$FX copyfile "$PWD/src/plain" "$PWD/out/plain"
cmp src/plain out/plain && echo "same bytes"
test -x out/plain || echo "not executable"
echo "== a link at the source is followed: the target is a plain file with the bytes of the file behind the link"
ln -s "$PWD/src/roc" src/lnk
$FX copyfile "$PWD/src/lnk" "$PWD/out/from-link"
test -L out/from-link || echo "not a link"
cmp src/roc out/from-link && echo "same bytes"
test -x out/from-link && echo "executable"
echo "== a later change of the source does not change the copy (R-LK2: a fixed build)"
printf '#!/bin/sh\necho "the source changed"\n' > src/roc
./out/deep/roc
echo "== the target exists: Exists. Nothing is replaced."
$FX copyfile "$PWD/src/plain" "$PWD/out/deep/roc"
./out/deep/roc
echo "== the source is missing: NotFound. Nothing is made."
$FX copyfile "$PWD/src/missing" "$PWD/out/never/roc"
test ! -e out/never && echo "nothing was made"
echo "== the source is a directory: Other"
$FX copyfile "$PWD/src" "$PWD/out/dir" | sed -e 's/Other(.*)/Other(text of the platform)/'
test ! -e out/dir && echo "nothing was made"
rm -rf src out
