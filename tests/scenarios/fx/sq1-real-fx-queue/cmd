# R-SH3 R-SH4 R-TF7 R-TF2 R-TF3 R-CC8 TW4 (slice 215): db_query! QueueCount and db_write! Queue and ClearQueue of the real Fx, with `fxprobe` (no Talon logic in it: the cap is an argument). Slice 213 left the SQL of QueueCount and ClearQueue with no probe line.
# The python3 parts play "another program": they make files as an older Talon would, and read what the real Fx wrote.
FX=$(command -v fxprobe)
DB=$HOME/.cache/roc/talon/compat.db
NT=nightly-2026-10-14-38a3029
NT2=nightly-2026-10-12-2664a27
V=0.9.0
V2=0.8.0
T1=2026-11-03T10:00:00Z
T2=2026-11-03T10:01:00Z
T3=2026-11-03T10:02:00Z
T4=2026-11-03T10:03:00Z
T5=2026-11-03T10:04:00Z
mkdir -p t
sha() { if command -v sha256sum > /dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }
qrows() {
python3 -I - "$1" <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
for r in c.execute("SELECT seq, hash, nightly, target, result, talon_version, queued_at FROM share_queue ORDER BY seq"):
    print("row", *r)
PY
}
tables() {
python3 -I - "$1" <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
print("user_version", c.execute("PRAGMA user_version").fetchone()[0])
print("tables", sorted(r[0] for r in c.execute("SELECT name FROM sqlite_master WHERE type = 'table'")))
PY
}

echo "== 1. a file that does not exist: QueueCount is 0, ClearQueue and a Queue write with no row are ok, and none of them makes a file or a dir"
$FX db-query $DB 5000 queue-count
$FX db-write $DB 5000 clear-queue
$FX db-write $DB 5000 queue 10000
test ! -e $HOME/.cache && echo "nothing was made"

echo "== 2. a Queue write makes the dirs and the file (format 1, WAL) and the table share_queue (R-TF7), and gives seq 1 to 3 in the order of the rows"
$FX db-write $DB 5000 queue 10000 H1,$NT,any,pass,$V,$T1 H2,$NT,any,fail,$V,$T1 H3,$NT,linux_x86_64,crash,$V,$T2
python3 -I - $DB <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
print("journal_mode", c.execute("PRAGMA journal_mode").fetchone()[0])
print("user_version", c.execute("PRAGMA user_version").fetchone()[0])
print("tables", sorted(r[0] for r in c.execute("SELECT name FROM sqlite_master WHERE type = 'table'")))
print("columns", [(r[1], r[2], r[3], r[5]) for r in c.execute("PRAGMA table_info(share_queue)")])
unique = []
for idx in c.execute("PRAGMA index_list(share_queue)").fetchall():
    if idx[2] == 1:
        unique.append(tuple(r[2] for r in c.execute("PRAGMA index_info(%s)" % idx[1])))
print("unique", unique)
PY
qrows $DB
$FX db-query $DB 5000 queue-count

echo "== 3. R-TF7 UNIQUE (hash, nightly, target, talon_version): the same key with another result stays as it was. Another talon_version, another nightly and another hash are new rows. A repeat in the same call is one row (the first)."
$FX db-write $DB 5000 queue 10000 H1,$NT,any,fail,$V,$T2 H1,$NT,any,crash,$V2,$T2 H1,$NT2,any,pass,$V,$T2 H4,$NT,any,pass,$V,$T3 H4,$NT,any,fail,$V,$T3
qrows $DB
$FX db-query $DB 5000 queue-count

echo "== 4. R-SH4, the cap: with cap 4 a seventh row drops the oldest rows, the smallest seq (1, 2 and 3)"
$FX db-write $DB 5000 queue 4 H5,$NT,any,pass,$V,$T4
qrows $DB
$FX db-query $DB 5000 queue-count

echo "== 5. a repeat of a row that is in the queue adds no row and drops no row"
$FX db-write $DB 5000 queue 4 H5,$NT,any,fail,$V,$T5
qrows $DB
$FX db-query $DB 5000 queue-count

echo "== 6. a row that was dropped is a new row when it comes again: it has the next seq, and the oldest row (seq 4) goes"
$FX db-write $DB 5000 queue 4 H2,$NT,any,pass,$V,$T5
qrows $DB

echo "== 7. a call with more new rows than the cap (5 rows, cap 3): the queue keeps the last 3 rows"
$FX db-write $DB 5000 queue 3 H6,$NT,any,pass,$V,$T5 H7,$NT,any,pass,$V,$T5 H8,$NT,any,pass,$V,$T5 H9,$NT,any,pass,$V,$T5 H10,$NT,any,pass,$V,$T5
qrows $DB
$FX db-query $DB 5000 queue-count

echo "== 8. R-TF2: the 3 tables do not touch each other. A facts write leaves the queue, and the queue has the same 3 rows"
$FX db-write $DB 5000 facts replace H1:$NT:any:pass::
$FX db-query $DB 5000 facts H1:$NT:any
$FX db-query $DB 5000 queue-count
tables $DB

echo "== 9. R-TF7: a file of an older Talon (format 1, the tables facts and pinned, no share_queue). QueueCount gives 0 and makes no table. A Queue write makes the table with CREATE TABLE IF NOT EXISTS, keeps user_version 1 and the facts."
python3 -I - t/old.db <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
c.execute("CREATE TABLE facts (hash TEXT NOT NULL, nightly TEXT NOT NULL, target TEXT NOT NULL, outcome TEXT NOT NULL, modules TEXT NOT NULL, closure TEXT NOT NULL, PRIMARY KEY (hash, nightly, target, closure)) WITHOUT ROWID")
c.execute("CREATE TABLE pinned (tag TEXT NOT NULL, target TEXT NOT NULL, sha256 TEXT NOT NULL, source TEXT NOT NULL, PRIMARY KEY (tag, target)) WITHOUT ROWID")
c.execute("INSERT INTO facts VALUES ('old', 'n', 'any', 'pass', '', '')")
c.execute("PRAGMA user_version = 1")
c.commit()
c.close()
PY
cp t/old.db t/old2.db
$FX db-query t/old.db 5000 queue-count
tables t/old.db
$FX db-write t/old.db 5000 queue 10000 H1,$NT,any,pass,$V,$T1
tables t/old.db
qrows t/old.db
$FX db-query t/old.db 5000 facts old:n:any
$FX db-query t/old.db 5000 queue-count

echo "== 10. ClearQueue on the same kind of file: it makes the table (ok), then it removes all rows, and the facts and the version stay"
$FX db-write t/old2.db 5000 clear-queue
tables t/old2.db
$FX db-write t/old2.db 5000 queue 10000 H1,$NT,any,pass,$V,$T1 H2,$NT,any,fail,$V,$T1
$FX db-query t/old2.db 5000 queue-count
$FX db-write t/old2.db 5000 clear-queue
$FX db-query t/old2.db 5000 queue-count
$FX db-query t/old2.db 5000 facts old:n:any
tables t/old2.db

echo "== 11. a file with user_version 0 (no Talon table): QueueCount is 0 and makes no table"
python3 -I - t/zero.db <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
c.execute("CREATE TABLE other (a TEXT)")
c.commit()
c.close()
PY
$FX db-query t/zero.db 5000 queue-count
tables t/zero.db

echo "== 12. R-TF3: a file with a newer format (2). QueueCount, a Queue write and ClearQueue give TooNew, and the bytes of the file stay the same"
python3 -I - t/new.db <<'PY'
import sqlite3, sys
c = sqlite3.connect(sys.argv[1])
c.execute("CREATE TABLE facts (hash TEXT NOT NULL, nightly TEXT NOT NULL, target TEXT NOT NULL, outcome TEXT NOT NULL, modules TEXT NOT NULL, closure TEXT NOT NULL, PRIMARY KEY (hash, nightly, target)) WITHOUT ROWID")
c.execute("PRAGMA user_version = 2")
c.commit()
c.close()
PY
before=$(sha t/new.db)
$FX db-query t/new.db 5000 queue-count
$FX db-write t/new.db 5000 queue 10000 H1,$NT,any,pass,$V,$T1
$FX db-write t/new.db 5000 clear-queue
after=$(sha t/new.db)
test "$before" = "$after" && echo "the file is the same"

echo "== 13. a file that is not a database: Failed for the 3 calls, and the text file is the same"
printf 'this is not a database file, only text, padding padding padding padding padding padding padding padding' > t/text.db
before=$(sha t/text.db)
$FX db-query t/text.db 5000 queue-count | sed -e 's/Failed(.*/Failed(...)/'
$FX db-write t/text.db 5000 queue 10000 H1,$NT,any,pass,$V,$T1 | sed -e 's/Failed(.*/Failed(...)/'
$FX db-write t/text.db 5000 clear-queue | sed -e 's/Failed(.*/Failed(...)/'
after=$(sha t/text.db)
test "$before" = "$after" && echo "the text file is the same"
rm -rf t
