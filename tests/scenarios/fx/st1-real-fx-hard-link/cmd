# R-ST7 R-HF7 R-ST9 TW4 (slice 027): hard_link! of the real Fx, with `fxprobe` (no Talon logic in it). The target is a new name for the same file: the same inode, the same bytes and permission bits. The call makes no parent dir and no temp file:
# Talon links to a temp name and renames it (R-CC1). After a `rename` over the source, the link keeps the old file (the reason of R-ST9: setup repairs entries that a tool update left behind).
FX=$(command -v fxprobe)
mkdir -p src out
printf '#!/bin/sh\necho "the old file runs: $0"\n' > src/tln
chmod 755 src/tln
printf 'plain data\n' > src/plain
chmod 644 src/plain

echo "== a hard link: the same file (the same inode), the same bytes, still executable. No temp file is made by the call."
$FX hardlink "$PWD/src/tln" "$PWD/out/tln"
if [ src/tln -ef out/tln ]; then echo "same file"; else echo "other file"; fi
test -x out/tln && echo "executable"
./out/tln
echo "== the permission bits are the ones of the source: a file with no executable bit stays so"
$FX hardlink "$PWD/src/plain" "$PWD/out/plain"
test -x out/plain || echo "not executable"
echo "== a rename over the source (what a tool update does): the link keeps the old file"
printf '#!/bin/sh\necho "the new file runs: $0"\n' > src/new
chmod 755 src/new
mv src/new src/tln
./src/tln
./out/tln
if [ src/tln -ef out/tln ]; then echo "same file"; else echo "other file"; fi
echo "== the target exists: Exists. Nothing is replaced."
$FX hardlink "$PWD/src/tln" "$PWD/out/tln"
./out/tln
echo "== the source is missing: NotFound. Nothing is made."
$FX hardlink "$PWD/src/missing" "$PWD/out/never"
test ! -e out/never && echo "nothing was made"
echo "== the parent dir of the target is missing: NotFound. The call makes no dir."
$FX hardlink "$PWD/src/tln" "$PWD/out/missing/deep/x"
test ! -e out/missing && echo "no dir was made"
echo "== the source is a directory: Other"
$FX hardlink "$PWD/src" "$PWD/out/dir" | sed -e 's/Other(.*)/Other(text of the platform)/'
test ! -e out/dir && echo "nothing was made"
rm -rf src out
