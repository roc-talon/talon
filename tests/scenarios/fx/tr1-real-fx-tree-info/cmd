# R-GC3 R-GC4 R-GC11 TW4 (slice 028b): tree_info! of the real Fx, with `fxprobe` (no Talon logic in it). It gives, for each path, the newest time of a file below it and the sum of the sizes of the files.
# The time of a directory does not count (an entry that is added or removed changes it, a file that changes does not). A link is not followed and not counted. All the paths of one call are answered in the order of the list.
# `touch -d` sets the times (TZ is UTC): 1000000000 is 2001-09-09 01:46:40.
FX=$(command -v fxprobe)
mkdir -p t/deep/er only/leaf/inner out
printf 'aaaa' > t/one
printf 'bbbbbbbbbb' > t/deep/two
printf 'c' > t/deep/er/three
ln -s deep t/link-to-deep
ln -s one t/link-to-one
ln -s ../t out/link-to-t
touch -d '2001-09-09 01:46:40' t/one
touch -d '2002-09-09 01:46:40' t/deep/two
touch -d '2001-09-09 01:46:41' t/deep/er/three
touch -d '2030-01-01 00:00:00' t/deep/er t/deep t
touch -d '2005-05-05 05:05:05' only/leaf/inner
touch -d '2004-04-04 04:04:04' only/leaf
touch -d '2003-03-03 03:03:03' only
touch -d '2006-06-06 06:06:06' out

echo "== a tree, a file, a tree with only empty dirs, a missing path, and a dir with only a link: one call, the order of the list"
echo "== t: the newest file is deep/two (the dirs are 2030 and do not count), 4 + 10 + 1 bytes, the 2 links are not followed"
echo "== t/one: a file has its own time and size. only: no file below, so its own time (2003). missing: NotFound. out: only a link below, so its own time (2006) and size 0."
$FX tree t t/one only missing out
echo "== a path of a tree is the same in a second call (the call changes nothing)"
$FX tree t
echo "== no path: no answer"
$FX tree
rm -rf t only out
