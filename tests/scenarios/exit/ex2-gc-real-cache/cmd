# R-GC2 R-GC3 R-GC4 R-GC1 R-GC9 R-GC11 R-LY1 R-J3 R-OUT4 R-CC10 (slice 053, the P1 exit criterion of Design 7): "GC frees the legacy dirs", on a copy of a real roc cache.
# L4 (tag real-roc): the real tln, the real Fx, the real file times. No network. The cache is a COPY of the real cache (TALON_TEST_REAL_CACHE: ~/.cache/roc of the caller, or REAL_CACHE). The case only reads the original (cp -a).
# The copy is in the case dir, outside home/ and project/ (the tree diff has no GB), and the case deletes it when it ends. tln gets XDG_CACHE_HOME and ROC_CACHE_DIR of the copy (R-LY1), so it never sees the real cache.
# The ages are made here, so the result does not depend on the day or on the use of the real cache: the first dir of each kind (in the order of the names) is mixed (all files get the year 2000 but one, which gets the time now), the second one is 3 days old, the dirs between are old (all files get the year 2000), and the last one is young (all files get the time now). 3 days is inside the 7 days of gc-age (a legacy dir and a compat dir stay: R-GC2, R-GC3) and outside the 1 day of a package (it goes: R-GC4). config.toml has `gc-age = "7d"`.
# Each kind of dir is "legacy" (nightly-<tag>, debug-<sha>: compilers from 2026-10-05 do not write them, R-GC2), compat-<id> (R-GC3) or packages/<hash> (R-GC4, no known project). The lines of the output have no name, size or count of the machine.
# Needs a real cache with 4 legacy dirs or more, 4 compat dirs or more and 4 packages or more. A cache dir that does not exist: the runner skips the case (the file needs-real-cache). A cache with too few dirs: the case fails (it does not skip).
SRC=${TALON_TEST_REAL_CACHE:?no real cache given}
X=$TALON_TEST_DIR/xdg
R=$X/roc
trap 'rm -rf "${X:?}"' EXIT
check() { python3 -I "$TALON_TEST_DIR/check.py" "$@"; }
mkdir -p "$X"
cp -a "$SRC" "$R"
export XDG_CACHE_HOME=$X ROC_CACHE_DIR=$R
OLD='2000-01-01 00:00:00'
# The order of the legacy dirs: the first 2 nightly dirs, then the debug dirs, then the other nightly dirs. So a debug dir is an old one (it goes) when the cache has one.
(cd "$R" && ls -d nightly-* 2> /dev/null | sort) > "$X/nightly.lst"
(cd "$R" && ls -d debug-* 2> /dev/null | sort) > "$X/debug.lst"
{ sed -n 1,2p "$X/nightly.lst"; cat "$X/debug.lst"; sed '1,2d' "$X/nightly.lst"; } > "$X/legacy.lst"
(cd "$R" && ls -d compat-* 2> /dev/null | sort) > "$X/compat.lst"
(cd "$R/packages" && ls -d */ 2> /dev/null | tr -d / | sort) > "$X/pkgs.lst"
for k in legacy compat pkgs; do
    if [ "$(wc -l < "$X/$k.lst")" -lt 4 ]; then echo "the real cache has fewer than 4 dirs of the kind $k"; exit 3; fi
done
echo "== 0: the copy, and the ages: the first dir of each kind is mixed, the second is 3 days old, the dirs between are old, the last one is young (the real clock)."
age() { # age <kind file> <dir of the kind>: the first is mixed, the second is 3 days old, the last is young, the others are old
    first=$(head -n 1 "$1")
    second=$(sed -n 2p "$1")
    last=$(tail -n 1 "$1")
    while read -r n; do
        if [ "$n" = "$last" ]; then
            find "$2/$n" -exec touch -h {} +
        elif [ "$n" = "$second" ]; then
            find "$2/$n" -exec touch -h -d '3 days ago' {} +
        else
            find "$2/$n" -exec touch -h -d "$OLD" {} +
            if [ "$n" = "$first" ]; then find "$2/$n" -type f | sort | tail -n 1 | while read -r f; do touch -h "$f"; done; fi
        fi
    done < "$1"
}
age "$X/legacy.lst" "$R"
age "$X/compat.lst" "$R"
age "$X/pkgs.lst" "$R/packages"
while read -r n; do [ -f "$R/packages/$n.deps.json" ] && touch -h -d "$OLD" "$R/packages/$n.deps.json"; done < "$X/pkgs.lst"
true
# The sets that GC must find, from the files of the copy (not from tln). Builds: the old dirs, not the first (one young file), not the second (3 days, inside gc-age) and not the last. Packages: also the second (3 days is over 1 day).
sed '1,2d;$d' "$X/legacy.lst" > "$X/want-dirs.lst"
sed '1,2d;$d' "$X/compat.lst" >> "$X/want-dirs.lst"
sed '1d;$d' "$X/pkgs.lst" > "$X/want-pkgs.lst"
files() { (cd "$R" && find . -type f | sort); }
files > "$X/before.lst"
echo "== 1: a dry run (R-GC11): the old legacy dirs, the old compat dirs and the old packages are listed with their sizes. The total is the sum of the file sizes. Nothing is removed."
if tln cache gc --dry-run --json > "$X/dry.json" 2> "$X/dry.err"; then echo "exit 0"; else echo "exit $?"; fi
check dry "$X/dry.json" "$R" "$X/want-dirs.lst" "$X/want-pkgs.lst" "$X/freed.txt"
files > "$X/after-dry.lst"
if cmp -s "$X/before.lst" "$X/after-dry.lst"; then echo "dry run: the tree is the same: yes"; else echo "dry run: the tree is the same: no"; fi
echo "== 2: the real run (R-GC2, R-GC3, R-GC4): the same sets go, with the sidecars of the packages. Nothing else changes: the mixed dir (one young file), the dir of 3 days (for builds) and the young dir of each kind stay whole (R-GC1: GC does not look inside a kept build cache)."
if tln cache gc --json > "$X/gc.json" 2> "$X/gc.err"; then echo "exit 0"; else echo "exit $?"; fi
check gc "$X/gc.json" "$R" "$X/want-dirs.lst" "$X/want-pkgs.lst" "$X/freed.txt"
files > "$X/after.lst"
# The expected tree: the files before, without the files in the dirs of the want lists and without the sidecars of the old packages.
cp "$X/before.lst" "$X/expect.lst"
while read -r n; do grep -v "^\./$n/" "$X/expect.lst" > "$X/e.tmp"; mv "$X/e.tmp" "$X/expect.lst"; done < "$X/want-dirs.lst"
while read -r n; do grep -v "^\./packages/$n/" "$X/expect.lst" | grep -v "^\./packages/$n\.deps\.json$" > "$X/e.tmp"; mv "$X/e.tmp" "$X/expect.lst"; done < "$X/want-pkgs.lst"
if cmp -s "$X/expect.lst" "$X/after.lst"; then echo "real run: the tree lost exactly the listed dirs and sidecars: yes"; else echo "real run: the tree lost exactly the listed dirs and sidecars: no"; fi
echo "== 3: the legacy dirs are gone, except the mixed one, the one of 3 days and the young one (the first, the second and the last by name)"
n=0
while read -r d; do [ -d "$R/$d" ] && n=$((n + 1)); done < "$X/legacy.lst"
echo "legacy dirs left: $n"
echo "== 4: a second run has nothing to remove (R-GC11)"
st=0
tln cache gc > "$X/gc2.out" 2> "$X/gc2.err" || st=$?
echo "exit $st"
cat "$X/gc2.out" "$X/gc2.err"
