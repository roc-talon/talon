# R-CM15 R-CM19 R-CS2 R-RR1 R-SO24 R-RR2 R-RR3 R-RM2 R-R5 R-SC9 R-SC10 R-SC13 R-NS3 R-GC3 R-CC1 R-CC6 R-CC10 R-J3 R-LY1 (slice 024): `tln roc ls`, `default` and `rm` on the real binary, with the real Fx (list, read, lock, rename, delete, write).
# The store: 3 nightlies, a git build, a link, a copy, and the compat dirs of 2 of them. The default is the nightly of 2026-10-14. No network (the commands need none).
export TALON_NOW=2026-10-22T12:00:00Z
st() { echo "== $*"; if "$@"; then echo "exit 0"; else echo "exit $?"; fi; }
T=$XDG_CACHE_HOME/roc/toolchains
C=$XDG_CONFIG_HOME/talon/config.toml
# The link points to a file in the project dir. A known project holds paths, so projects.json is written here (R-PD9). The 2 projects pin the nightly of 2026-10-09.
mkdir -p $XDG_CACHE_HOME/roc/talon
printf '{"format":1,"projects":[{"path":"%s/pa/main.roc","last_use":1792065600},{"path":"%s/pb/main.roc","last_use":1792065600}]}\n' "$PWD" "$PWD" > $XDG_CACHE_HOME/roc/talon/projects.json
sed -i "s#ROC_SRC#$PWD/roc-src#" $T/link-dev/.talon.json

echo "== 1: the list (R-LY1, R-CM19: ls). The lock, the temp dir and the files of toolchains/ are no compiler."
st tln roc ls
st tln roc list --json

echo "== 2: a unique prefix gives the full id (R-SC13, R-SC10). The value is replaced, the comments and the other lines stay (R-CC6)."
st tln roc default nightly-2026-10-11
cat $C
st tln roc default nightly-2026-10-11-1a2b3c4
echo "== 3: a prefix of a git build (R-R5, R-SC9). R-CM15: a wrong number of operands."
st tln roc default git-dd
st tln roc default
st tln roc default nightly-2026-10-1
cat $C

echo "== 4: rm with a prefix. The projects pa and pb pin it (R-RR2): listed, no prompt. Its compat dir goes, the other stays (R-GC3)."
st tln roc rm nightly-2026-10-09
ls $T
ls $XDG_CACHE_HOME/roc | grep compat

echo "== 5: rm of the default (R-RR1): the default moves to the newest nightly by published_at, 2026-10-14 (a git build, a link and a copy are never the default, R-NS6). The value changes, the comments stay."
st tln roc rm git-dd03c09e
cat $C

echo "== 6: rm of a link (R-RR3, R-RM2): the dir of the link goes, the target stays."
st tln roc rm link-dev
ls roc-src
ls $T

echo "== 7: rm of the default again, with the nightly switch off (R-NS3): the switch admits no compiler that is left, so the default moves to the newest installed nightly of any kind (R-RR1, R-SO24: the default stays set), and a note says that the next use gives exit code 10 (R-SO19). Before slice 080 the line went."
st env TALON_NIGHTLY=0 tln roc rm nightly-2026-10-14-38a3029
cat $C
st tln roc ls
st tln roc rm nightly-2099
st tln roc rm

echo "== the store has no trash dir, no temp, no lock (R-CC1, R-CC10)"
find $XDG_CACHE_HOME/roc -name '*.trash' -o -name '*.tmp' -o -name '*.lock' | wc -l | tr -d ' '
ls $T
