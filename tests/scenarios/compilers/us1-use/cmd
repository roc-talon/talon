# line for each run to prog.log (its id, the dir name of the run, the command). The temp copy has a random dir name, so the script shows it as `<copy>`. The project has the pin O (nightly-2026-10-09-258ab27, not installed) and the new
# compiler is N (nightly-2026-10-14-38a3029, not installed). The runner has CI=true: no run has a person. TALON_NOW=2026-10-22T12:00:00Z.
st() { echo "== $*"; if "$@"; then echo "exit 0"; else echo "exit $?"; fi; }
D=$TALON_TEST_DIR
T=$HOME/.cache/roc/toolchains
N=nightly-2026-10-14-38a3029
O=nightly-2026-10-09-258ab27
requests() { if [ -f $D/http.log ]; then grep -c "$1" $D/http.log; else echo 0; fi; }
show() {
    echo "-- compiler runs"
    if [ -f $D/prog.log ]; then sed -E 's/cwd=[0-9a-f]{16}/cwd=<copy>/' $D/prog.log | sort; fi
    rm -f $D/prog.log
}
store() { if [ -d $T ]; then ls $T | tr '\n' ' '; fi; echo; }
