# R-CS3 R-RU1 R-RU2 R-RU3 R-RU4 R-NI6 R-DL4 R-NS1 R-NS3 R-C7 R-CM19 R-SO15 R-J3 R-OUT4 R-DI12 R-NS2 (slice 026): `tln roc update` end to end with the real Fx, the real curl and tar, and the fake release server
# (tests/tools/mk-nightly.sh with ARCHIVE=real made given/http: `ARCHIVE=real mk-nightly.sh given/http nightly-2026-10-21-5349569@2026-10-21T18:00:00Z nightly-2026-10-14-38a3029 nightly-2026-10-09-258ab27`).
# The time is fixed to 2026-10-22T12:00:00Z (TALON_NOW): the nightly of 2026-10-21 is 18 hours old, so min-release-age (2 days) hides it. The newest compiler that is allowed is nightly-2026-10-14-38a3029.
# The runner has CI=true, so no run has a person: a download that the command names starts with no prompt (R-DL4).
export TALON_NOW=2026-10-22T12:00:00Z
st() { if "$@"; then echo "exit 0"; else echo "exit $?"; fi; }
T=$XDG_CACHE_HOME/roc/toolchains
C=$XDG_CONFIG_HOME/talon/config.toml

echo "== 1: nothing is installed, no default. The newest allowed compiler is installed, and it is the default (R-SO15). The nightly of 2026-10-21 is too young (R-C7)."
st tln roc update
ls $T
cat $C

echo "== 2: the newest is installed: the text names it, and nothing else happens (R-RU1). The alias up (R-CM19)."
st tln roc up
ls $T

echo "== 3: an older compiler becomes the default. The newest is installed, so nothing is downloaded, but the default moves to it (R-CS3, R-RU2, answer Q1 of the review): the line is-the-newest, then the move line."
st tln roc install nightly-2026-10-09-258ab27
st tln roc default nightly-2026-10-09-258ab27
st tln roc update
cat $C
ls $T

echo "== 4: --json: stdout is only the envelope. Nothing is new and the default is the newest already (step 3), so installed and changed are false, and previous is the newest."
st tln roc update --json

echo "== 5: a project with a roc: pin is not touched (R-RU3), and the old compilers stay (R-RU4). The header is as it was (the default is the newest, step 3)."
cat main.roc

echo "== 6: a link build is the default (R-RU2): a new store, the link, the default, then update. The compiler is installed, the default stays, and the note says how to change it."
export ROC_CACHE_DIR=$PWD/c2/roc XDG_CACHE_HOME=$PWD/c2 XDG_CONFIG_HOME=$PWD/cfg2
T=$XDG_CACHE_HOME/roc/toolchains
C=$XDG_CONFIG_HOME/talon/config.toml
st tln roc link dev $PWD/roc-src/roc
st tln roc default link-dev
st tln roc update
ls $T
cat $C

echo "== 7: --offline with no cached list (a new store): exit 15, nothing is installed (R-DI12)."
export ROC_CACHE_DIR=$PWD/c3/roc XDG_CACHE_HOME=$PWD/c3 XDG_CONFIG_HOME=$PWD/cfg3
st tln roc update --offline
ls $XDG_CACHE_HOME/roc/toolchains 2> /dev/null | wc -l | tr -d ' '

echo "== 8: the nightly switch is off and the list has no release (R-NS2, R-NS3): exit 10, the text names the switch. An operand is a usage error (exit 2)."
st env TALON_NIGHTLY=0 tln roc update
st tln roc update nightly-2026-10-14-38a3029

echo "== the stores have no temp dir and no lock (R-CC1, R-CC4)"
find $PWD/home $PWD/c2 $PWD/c3 -name '*.tmp' -o -name '*.lock' -o -name '*.lock.*' 2> /dev/null | wc -l | tr -d ' '
