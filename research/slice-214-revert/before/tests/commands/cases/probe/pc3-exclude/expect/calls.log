args
env_all
clock
cwd
canonical $PROJECT/p3/main.roc
list_dirs $PROJECT/p3
list_dirs $PROJECT
read_files $PROJECT/p3/talon.toml
read_files $PROJECT/p3/main.roc
canonical $PROJECT/p3/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
spawn_all limit=1
  job - /fake/bin/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/p3/main.roc $PROJECT/p3/talon.toml $HOME/.config/talon/config.toml
list_dirs $HOME/.cache/roc/toolchains
random
list_dirs $HOME/.cache/roc/packages
platform
list_dirs $HOME/.cache/roc/talon/index/github/roc-lang/nightlies
programs gh
http_get https://api.github.com/repos/roc-lang/nightlies/releases?per_page=100
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/github/roc-lang/nightlies/1.json $HOME/.cache/roc/talon/index/github/roc-lang/nightlies/1.meta
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 pinned=10
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 pinned=10
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=10
canonical $HOME/.cache $HOME/.cache/roc
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-07-7b7b7b7/.last-use
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-06-6a6a6a6/.last-use
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-05-5f5f5f5/.last-use
probes 3
  probe $HOME/.cache/roc/packages/EiSZVhEG7h44iRLspsGTX5NRmJbz4fHktH4XcpRqFyjt nightly-2026-10-07-7b7b7b7 $HOME/.cache/roc/toolchains/nightly-2026-10-07-7b7b7b7/roc check main.roc timeout=9
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
  probe $HOME/.cache/roc/packages/EiSZVhEG7h44iRLspsGTX5NRmJbz4fHktH4XcpRqFyjt nightly-2026-10-06-6a6a6a6 $HOME/.cache/roc/toolchains/nightly-2026-10-06-6a6a6a6/roc check main.roc timeout=9
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
  probe $HOME/.cache/roc/packages/EiSZVhEG7h44iRLspsGTX5NRmJbz4fHktH4XcpRqFyjt nightly-2026-10-05-5f5f5f5 $HOME/.cache/roc/toolchains/nightly-2026-10-05-5f5f5f5/roc check main.roc timeout=9
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=3 existing=replace
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-01-1b1b1b1/.last-use
write_atomic $HOME/.cache/roc/toolchains/nightly-2026-10-03-3d3d3d3/.last-use
probes 2
  probe $HOME/.cache/roc/packages/EiSZVhEG7h44iRLspsGTX5NRmJbz4fHktH4XcpRqFyjt nightly-2026-10-01-1b1b1b1 $HOME/.cache/roc/toolchains/nightly-2026-10-01-1b1b1b1/roc check main.roc timeout=9
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
  probe $HOME/.cache/roc/packages/EiSZVhEG7h44iRLspsGTX5NRmJbz4fHktH4XcpRqFyjt nightly-2026-10-03-3d3d3d3 $HOME/.cache/roc/toolchains/nightly-2026-10-03-3d3d3d3/roc check main.roc timeout=9
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=2 existing=replace
