args
env_all
clock
cwd
canonical $PROJECT/ws/apps/b/main.roc
list_dirs $PROJECT/ws/apps/b
list_dirs $PROJECT/ws/apps
list_dirs $PROJECT/ws
read_files $PROJECT/ws/talon.toml
list_dirs $PROJECT/ws/apps/a
read_files $PROJECT/ws/apps/b/main.roc
canonical $PROJECT/ws/apps/a/main.roc $PROJECT/ws/apps/b/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
spawn_all limit=1
  job - /fake/bin/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/ws/apps/a/main.roc $PROJECT/ws/apps/b/main.roc $PROJECT/ws/apps/a/talon.toml $PROJECT/ws/apps/talon.toml $PROJECT/ws/talon.toml $PROJECT/ws/apps/b/talon.toml $HOME/.config/talon/config.toml
list_dirs $HOME/.cache/roc/talon/index/github/acme/json
programs gh
http_get https://api.github.com/repos/acme/json/releases?per_page=100
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/github/acme/json/1.json $HOME/.cache/roc/talon/index/github/acme/json/1.meta
random
list_dirs $HOME/.cache/roc/packages
read_files $HOME/.cache/roc/packages/3CjxCHLyKRMyh9nKodyVQYJcsttYAyPLjYTpoH2fnZtA/main.roc
list_dirs $HOME/.cache/roc/talon/index/github/acme/yaml
programs gh
http_get https://api.github.com/repos/acme/yaml/releases?per_page=100
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/github/acme/yaml/1.json $HOME/.cache/roc/talon/index/github/acme/yaml/1.meta
list_dirs $HOME/.cache/roc/talon/index/github/acme/pfx
programs gh
http_get https://api.github.com/repos/acme/pfx/releases?per_page=100
  User-Agent: tln/0.0.1
write_atomic $HOME/.cache/roc/talon/index/github/acme/pfx/1.json $HOME/.cache/roc/talon/index/github/acme/pfx/1.meta
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=1
list_dirs $HOME/.cache/roc/toolchains
canonical $HOME/.cache $HOME/.cache/roc
probes 1
  probe $HOME/.cache/roc/packages/3CjxCHLyKRMyh9nKodyVQYJcsttYAyPLjYTpoH2fnZtA nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
db_write $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=1 existing=replace
random
list_dirs $HOME/.cache/roc/packages
read_files $HOME/.cache/roc/packages/ETHqKvPfSpgiJzvkfaLumTGq3KhTvan7meq82W7wz73L/main.roc $HOME/.cache/roc/packages/2iuyo7Nm3YsiNGM8YRPbNFECroxdtbeAfQ9L6WfH9zLh/main.roc $HOME/.cache/roc/packages/6ELEWECd4np7xs4pF1M2Acyy9ZXcKsJN36LKrNFDuoBL/main.roc
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=3
random
copy_tree $PROJECT/ws/apps/a $HOME/.cache/roc/talon/tmp/0123456789abcdef
list_dirs $HOME/.cache/roc/talon/tmp/0123456789abcdef
write_atomic $HOME/.cache/roc/talon/tmp/0123456789abcdef/main.roc
probes 1
  probe $PROJECT/ws/apps/a nightly-2026-10-14-38a3029 /fake/bin/roc check main.roc timeout=30
    env XDG_CACHE_HOME=$HOME/.cache ROC_CACHE_DIR=$HOME/.cache/roc TALON_IN_PROXY=1
delete $HOME/.cache/roc/talon/tmp/0123456789abcdef
