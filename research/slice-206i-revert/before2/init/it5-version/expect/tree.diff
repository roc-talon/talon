--- project/v1/.github/workflows/ci.yml
+++ project/v1/.github/workflows/ci.yml
@@ -0,0 +1,21 @@
+name: CI
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    env:
+      TALON_AUTO_INSTALL: "yes"
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install Talon
+        run: curl -fsSL https://github.com/roc-talon/talon/releases/download/v0.0.1/install.sh | sh -s -- --yes --version 0.0.1
+      - name: Install packages
+        run: tln install --frozen
+      - name: Check
+        run: roc check
+      - name: Test
+        run: roc test
--- project/v1/main.roc
+++ project/v1/main.roc
@@ -0,0 +1,6 @@
+app [main!] {
+	pf: platform "https://github.com/acme/pfx/releases/download/1.2.0/539VFTyu6WmbCR6quL3VNv8PsbkPg6TgjqhZ3aMGRkFA.tar.zst",
+	roc: "nightly-2026-10-11-1f1f1f1",
+}
+
+main! = || crash "write the app"
