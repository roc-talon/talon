env_all
list_dirs $PROJECT
read_files $PROJECT/talon.toml
read_files $PROJECT/main.roc
read_files $PROJECT/main.roc $PROJECT/talon.toml $HOME/.config/talon/config.toml
list_dirs $HOME/.cache/roc/talon/index/github/acme/pf
programs gh
http_get https://api.github.com/repos/acme/pf/releases?per_page=100
  User-Agent: tln/0.0.0
write_atomic $HOME/.cache/roc/talon/index/github/acme/pf/1.json $HOME/.cache/roc/talon/index/github/acme/pf/1.meta
db_query $HOME/.cache/roc/talon/compat.db busy_ms=5000 format=1 facts=1
