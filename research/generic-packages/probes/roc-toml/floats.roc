# Checks that each F64 literal in the generated tests equals F64.from_str of its text.
main! = |_args| Ok({})

f : F64 -> F64
f = |x| x
expect f(-0.0) == (F64.from_str("-0.0") ?? 99.0)
expect f(-0.01) == (F64.from_str("-0.01") ?? 99.0)
expect f(0.0123) == (F64.from_str("0.0123") ?? 99.0)
expect f(-0.02) == (F64.from_str("-0.02") ?? 99.0)
expect f(0.03) == (F64.from_str("0.03") ?? 99.0)
expect f(0.1) == (F64.from_str("0.1") ?? 99.0)
expect f(0.123) == (F64.from_str("0.123") ?? 99.0)
expect f(0.2) == (F64.from_str("0.2") ?? 99.0)
expect f(0.5) == (F64.from_str("0.5") ?? 99.0)
expect f(1.0) == (F64.from_str("1.0") ?? 99.0)
expect f(1000.0) == (F64.from_str("1000.0") ?? 99.0)
expect f(1000000.0) == (F64.from_str("1000000.0") ?? 99.0)
expect f(1.1) == (F64.from_str("1.1") ?? 99.0)
expect f(11.1) == (F64.from_str("11.1") ?? 99.0)
expect f(1.5) == (F64.from_str("1.5") ?? 99.0)
expect f(1e6) == (F64.from_str("1e6") ?? 99.0)
expect f(2.1) == (F64.from_str("2.1") ?? 99.0)
expect f(224617.445991228) == (F64.from_str("224617.445991228") ?? 99.0)
expect f(3.0) == (F64.from_str("3.0") ?? 99.0)
expect f(300.0) == (F64.from_str("300.0") ?? 99.0)
expect f(300000000000000.0) == (F64.from_str("300000000000000.0") ?? 99.0)
expect f(3.1) == (F64.from_str("3.1") ?? 99.0)
expect f(310.0) == (F64.from_str("310.0") ?? 99.0)
expect f(-3.14) == (F64.from_str("-3.14") ?? 99.0)
expect f(3.1415) == (F64.from_str("3.1415") ?? 99.0)
expect f(3.141592653589793) == (F64.from_str("3.141592653589793") ?? 99.0)
expect f(3141.5927) == (F64.from_str("3141.5927") ?? 99.0)
expect f(42.666) == (F64.from_str("42.666") ?? 99.0)
expect f(5.5) == (F64.from_str("5.5") ?? 99.0)
expect f(5e22) == (F64.from_str("5e22") ?? 99.0)
expect f(6.626e-34) == (F64.from_str("6.626e-34") ?? 99.0)
expect f(9.0) == (F64.from_str("9.0") ?? 99.0)
expect f(9007199254740991.0) == (F64.from_str("9007199254740991.0") ?? 99.0)
