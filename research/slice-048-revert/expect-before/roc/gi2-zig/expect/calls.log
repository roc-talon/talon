delete $HOME/.cache/roc/talon/tmp/0123456789abcdef/source.tar.gz
read_files $HOME/.cache/roc/talon/tmp/0123456789abcdef/src/build.zig.zon
platform
programs zig
list_dirs $HOME/.cache/roc/toolchains
clock
