env_all
platform
programs zig
list_dirs $HOME/.cache/roc/toolchains
clock
http_get https://ziglang.org/download/index.json
lock $HOME/.cache/roc/toolchains/zig-0.17.0 nowait: held
list_dirs $HOME/.cache/roc/toolchains
random
programs curl wget xz
unlock $HOME/.cache/roc/toolchains/zig-0.17.0
env_all
platform
programs zig
list_dirs $HOME/.cache/roc/toolchains
clock
http_get https://ziglang.org/download/index.json
lock $HOME/.cache/roc/toolchains/zig-0.17.0 nowait: held
list_dirs $HOME/.cache/roc/toolchains
random
programs curl wget xz
make_dirs $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp
spawn_all limit=8
  job - curl --fail --location --silent --show-error --proto =https,http --proto-redir =https --retry 2 --connect-timeout 30 --output $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/zig-aarch64-macos-0.17.0.tar.xz https://ziglang.org/download/0.17.0/zig-aarch64-macos-0.17.0.tar.xz
sha256_file $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/zig-aarch64-macos-0.17.0.tar.xz
spawn_all limit=1
  job - tar -xf $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/zig-aarch64-macos-0.17.0.tar.xz -C $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp --strip-components=1
delete $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/zig-aarch64-macos-0.17.0.tar.xz
spawn_all limit=1
  job - chmod 0755 $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/zig
write_atomic $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp/.talon.json
rename $HOME/.cache/roc/toolchains/zig-0.17.0.0123456789abcdef.tmp $HOME/.cache/roc/toolchains/zig-0.17.0
unlock $HOME/.cache/roc/toolchains/zig-0.17.0
