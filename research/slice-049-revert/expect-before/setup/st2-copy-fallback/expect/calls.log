args
env_all
platform
read_files $HOME/.local/share/talon/tools.json
list_dirs $HOME/.local/share/talon/bin $HOME/.local/bin
sha256_file $HOME/.local/share/talon/bin/tln
sha256_file $HOME/.local/bin/roc
path_roc
read_files $HOME/.local/share/bash-completion/completions/tln
tty
ask "$HOME/.local/bin/roc is a roc that Talon did not write. Move it to $HOME/.local/bin/roc.old and install the roc launcher? [y/N] "
make_dirs $HOME/.local/bin
rename $HOME/.local/bin/roc $HOME/.local/bin/roc.old
clock
lock $HOME/.cache/roc/toolchains/link-system nowait: held
list_dirs $HOME/.cache/roc/toolchains
random
write_atomic $HOME/.cache/roc/toolchains/link-system.0123456789abcdef.tmp/.talon.json
rename $HOME/.cache/roc/toolchains/link-system.0123456789abcdef.tmp $HOME/.cache/roc/toolchains/link-system
unlock $HOME/.cache/roc/toolchains/link-system
random
hard_link $HOME/.local/share/talon/bin/tln $HOME/.local/bin/tln.0123456789abcdef.tmp
copy_file $HOME/.local/share/talon/bin/tln $HOME/.local/bin/tln.0123456789abcdef.tmp
rename $HOME/.local/bin/tln.0123456789abcdef.tmp $HOME/.local/bin/tln
random
hard_link $HOME/.local/share/talon/bin/tln $HOME/.local/bin/roc.0123456789abcdef.tmp
copy_file $HOME/.local/share/talon/bin/tln $HOME/.local/bin/roc.0123456789abcdef.tmp
rename $HOME/.local/bin/roc.0123456789abcdef.tmp $HOME/.local/bin/roc
write_atomic $HOME/.local/share/bash-completion/completions/tln
