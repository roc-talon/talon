args
env_all
clock
cwd
canonical $PROJECT/p/main.roc
list_dirs $PROJECT/p
list_dirs $PROJECT
read_files $PROJECT/p/main.roc
canonical $PROJECT/p/main.roc
lock $HOME/.cache/roc/talon/projects.json nowait: held
list_dirs $HOME/.cache/roc/talon
read_files $HOME/.cache/roc/talon/projects.json
write_atomic $HOME/.cache/roc/talon/projects.json
unlock $HOME/.cache/roc/talon/projects.json
path_roc
read_files $HOME/.cache/roc/talon/path-roc.json
sha256_file $WORK/launcher/roc
sha256_file $WORK/bin/tln
sha256_file $WORK/old/roc
spawn_all limit=1
  job - $WORK/old/roc version
write_atomic $HOME/.cache/roc/talon/path-roc.json
read_files $PROJECT/p/main.roc $PROJECT/p/talon.toml $HOME/.config/talon/config.toml
