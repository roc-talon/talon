                "x:{x-2.0.0} & roc:{n2,n1} <- probe x-2.0.0 fail n1..n2 [Yaml] inferred []",
                "x:{x-2.0.0} & roc:{n3} <- probe x-2.0.0 fault n3..n3 [] inferred []",
