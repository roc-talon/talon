# the range `>=nightly-2026-10-10-0000000` is nightly-2026-10-12-1b2c3d4 (B). A is nightly-2026-10-14-5349569 and N is nightly-2026-10-13-0a1b2c3. The runner has CI=true: no run has a person. The store is empty at the start.
TLN=$(command -v tln)
st() { echo "== $*"; if "$@"; then echo "exit 0"; else echo "exit $?"; fi; }
D=$TALON_TEST_DIR
T=$HOME/.cache/roc/toolchains
C=$XDG_CONFIG_HOME/talon/config.toml
# slice 062 (R-SO15): a download for a probe, a pin or the proxy writes no default, so config.toml does not exist. The line says so.
default_roc() { if [ -e $C ]; then cat $C; else echo "no default-roc (no config.toml)"; fi; }
A=nightly-2026-10-14-5349569
N=nightly-2026-10-13-0a1b2c3
B=nightly-2026-10-12-1b2c3d4
requests() { if [ -f $D/http.log ]; then grep -c "$1" $D/http.log; else echo 0; fi; }
show() {
    echo "-- compiler runs"
    if [ -f $D/prog.log ]; then sort $D/prog.log; fi
    rm -f $D/prog.log
}
store() { if [ -d $T ]; then ls $T | tr '\n' ' '; fi; echo; }
echo "== R-SO13 R-DL1 R-DL2 R-DL4 R-NI5 R-C7: no person and no flag. The list is read once, the newest nightly that min-release-age allows (B, not the 2 newer ones) is the required download, and the run stops with exit 13 and the size of B. The store is empty."
st tln verify
show
store
echo "requests for compilers: $(requests nightlies)"
echo "== R-DL5 R-DL10: TALON_AUTO_INSTALL=no refuses before any request (the id is not known): exit 13, the text names the range and the 3 ways to get a compiler. No new request."
st env TALON_AUTO_INSTALL=no tln verify
store
echo "requests for compilers: $(requests nightlies)"
echo "== R-SO13 R-DL5 R-NI5 R-NM6 R-SO22 R-CC4 R-CC9 R-SO15: --allow-downloads answers the prompt for B. One answer line on stderr, one download of B only, the install under the lock, then the 3 probes run B. No default is written (R-SO15)."
st tln verify --allow-downloads
show
store
echo "last use of B: $(cat $T/$B/.last-use)"
default_roc
echo "downloads of B: $(requests "GET /dl/$B"), downloads of A: $(requests "GET /dl/$A")"
echo "== R-SO4 R-SO13: B is installed and in the range now. No list request, no download, the same 3 probes."
st tln verify
show
echo "requests for compilers: $(requests nightlies), downloads of B: $(requests "GET /dl/$B")"
echo "== R-NS2 R-NS3 R-SO13: the switch is off (TALON_NIGHTLY=0). The installed B is a nightly, so rank 4 has none, and the list has no release: exit 10, the text names the range, the switch and its source. No download, even with the flag."
