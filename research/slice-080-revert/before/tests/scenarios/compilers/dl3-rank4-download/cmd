echo "requests for compilers: $(requests nightlies)"
echo "== R-PX4 R-DL9 R-SO13 R-C7: the proxy, in p2 (no pin, range >=nightly-2026-10-13-0000000). B is below it. At the time 2026-10-15T20:00:00Z min-release-age hides A (10-14, 29 hours old), so the newest allowed nightly is N (10-13): the answer line, the install of N only, the run of the fake roc. stdout is only the output of the compiler."
mkdir -p $D/launch
cp "$TLN" $D/launch/roc
L=$D/launch/roc
st env TALON_NOW=2026-10-15T20:00:00Z TALON_AUTO_INSTALL=yes $L check p2/main.roc
store
echo "downloads of N: $(requests "GET /dl/$N"), downloads of A: $(requests "GET /dl/$A"), requests for compilers: $(requests nightlies)"
echo "== no temp dir and no lock is left."
find $HOME/.cache/roc -name '*.tmp' -o -name '*.lock' -o -name '*.lock.*' | wc -l | tr -d ' '
